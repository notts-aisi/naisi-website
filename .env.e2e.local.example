# e2e harness config — copy to .env.e2e.local and fill in.
#
# There are NO SECRETS in this file, by design. The harness authenticates with
# Application Default Credentials and reads the magic-link signing secret from
# Secret Manager at runtime, so nothing permanent is stored on disk. If you
# find yourself adding a FIREBASE_ADMIN_PRIVATE_KEY here, stop — the harness
# rejects it on purpose.
#
# One-time setup (the quota project matters: with it pointing elsewhere,
# minting sessions fails with an iam.serviceAccounts.signBlob denial):
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project naisi-website-dev
#
# When you are done for the day, this revokes the laptop's access entirely:
#   gcloud auth application-default revoke

# Must be an allowlisted origin (see scripts/e2e/lib/env.mjs). Default: dev.
E2E_TARGET=https://dev.naisi.uk

# The project every resource lands in. Asserted against a hard-coded literal.
FIREBASE_ADMIN_PROJECT_ID=naisi-website-dev

# DEV web API key — public by design (it is inlined into the client bundle).
# Firebase console → Project settings → General → Web API Key, on
# naisi-website-dev.
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_ME

# OPTIONAL, default off. Enables the /api/register enumeration battery, which
# is LOCAL ONLY and needs a captcha-relaxed server plus mail redirected to a
# local catcher. Read the header of tests/register-enumeration.test.mjs first.
E2E_ALLOW_REGISTER=0
