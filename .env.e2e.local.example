# e2e harness config — copy to .env.e2e.local and fill in DEV values.
#
# .env.e2e.local is git-ignored (.gitignore '.env*'). NEVER put production
# credentials here: the harness hard-fails if the project id or the service
# account is anything other than naisi-website-dev, but the first line of
# defence is not copying prod values in the first place. Note that .env.prod
# and .env.local.prod-snapshot-* in this repo root DO carry production.

# Must be an allowlisted origin (see scripts/e2e/lib/env.mjs). Default: dev.
E2E_TARGET=https://dev.naisi.uk

# DEV project Admin credentials (Firebase console → Project settings →
# Service accounts → Generate new private key, on naisi-website-dev).
FIREBASE_ADMIN_PROJECT_ID=naisi-website-dev
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@naisi-website-dev.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# DEV web API key — public by design (it is inlined into the client bundle).
# Used to exchange a custom token for an ID token via Identity Toolkit.
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_ME

# OPTIONAL. The DEV backend's magic-link signing secret, from Secret Manager
# (`gcloud secrets versions access latest --secret=EVENTS_TOKEN_SECRET
#   --project=naisi-website-dev`). Without it the token-negative battery skips
# and the rest still runs. It must be the DEV value, or every minted token is
# rejected — the positive control in token-negatives.test.mjs diagnoses this.
EVENTS_TOKEN_SECRET=

# OPTIONAL, default off. Enables the /api/register enumeration battery, which
# is LOCAL ONLY and needs a captcha-relaxed server plus mail redirected to a
# local catcher. Read the header of tests/register-enumeration.test.mjs first.
E2E_ALLOW_REGISTER=0
