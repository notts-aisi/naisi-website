# Firebase client config (public — these are safe to commit to git but we still
# keep them in env for easy per-environment swaps).
# Get these from the Firebase console: Project settings → General → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only, NEVER commit real values).
# For LOCAL DEV only — in production on Firebase App Hosting these are
# provided automatically via Application Default Credentials.
# Generate a service account key from: Firebase console → Project settings → Service accounts.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# SMTP for outbound email (transactional + newsletter). Uses Gmail Workspace
# SMTP for ai-safety@uonsu.com. Generate an app password at
# https://myaccount.google.com/apppasswords (2FA must be enabled).
# In production, store SMTP_PASSWORD as an App Hosting secret.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ai-safety@uonsu.com
SMTP_PASSWORD=
SMTP_FROM_NAME=NAISI
SMTP_FROM_EMAIL=ai-safety@uonsu.com

# Absolute base URL used in outbound email links (e.g. unsubscribe). Local dev:
# http://localhost:3000 ; production: your App Hosting URL (e.g. https://naisi.web.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# HMAC secret used to sign RSVP self-cancel / change-request links embedded in
# transactional event emails. Any random 32+ char string — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates every outstanding email link (that's a feature).
# In production, store as a Firebase App Hosting secret:
#   firebase apphosting:secrets:set EVENTS_TOKEN_SECRET
EVENTS_TOKEN_SECRET=

# Optional overrides — defaults (notts.ai.safety Insta, ai-safety@uonsu.com) are
# already baked into the code and only need setting if they ever change.
# NAISI_INSTAGRAM_HANDLE=notts.ai.safety
# NAISI_CONTACT_EMAIL=ai-safety@uonsu.com

# Web push (optional; the feature is dormant without both). Generate a pair
# with `npx web-push generate-vapid-keys`. The public key is build-inlined;
# the private key is server-only. See docs/pwa.md for backend provisioning.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
