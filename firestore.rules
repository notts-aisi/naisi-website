rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn()   { return request.auth != null; }
    function userRole()     { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function hasRole(roles) { return isSignedIn() && userRole() in roles; }
    function isAdmin()      { return hasRole(['admin']); }

    // SU-recognised committee: committee members the Students' Union formally
    // recognises. They are trusted with member PII (the users collection) and
    // full committee task powers. Non-SU committee are scoped to the tasks
    // they are explicitly added to. `suRecognised` is admin-set and locked
    // against self-service edits in the users create/update rules below.
    function isSuCommittee() {
      return hasRole(['committee'])
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('suRecognised', false) == true;
    }

    // Keep the user doc under a reasonable size cap as a DoS guard;
    // detailed shape validation happens in the React forms.
    function smallEnough() {
      return request.resource.data.size() <= 30
        && (!('profile' in request.resource.data)
            || request.resource.data.profile.size() <= 30);
    }

    // === users ===
    match /users/{uid} {
      // Member PII: emails, university email, application motivation, roles.
      // Readable only by SU-recognised committee and admins, plus each user
      // reading their own doc. A plain signed-in account (including one that
      // has signed in but not yet registered) can no longer enumerate the
      // membership. Non-admin task views resolve names via a server route.
      allow read: if isAdmin() || isSuCommittee()
        || (isSignedIn() && request.auth.uid == uid);

      // Self-create: must use own uid and start as 'pending'. `tracks`,
      // `permissions` and `suRecognised` are all admin-controlled. A
      // self-created doc must not seed any of them (the signup flow writes
      // none). Without these guards a user could self-grant drafter
      // permissions or SU-committee trust at create time.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'pending'
        && !('tracks' in request.resource.data)
        && !('permissions' in request.resource.data)
        && !('suRecognised' in request.resource.data)
        // `email` is the address the rest of the system treats as PROVEN: the
        // subscription sync marks rows `confirmed` from it without a click, the
        // newsletter sender resolves recipients from it, and the application
        // email routes mail it. It must therefore equal the address Firebase
        // Auth actually verified, never a value the client picked.
        && request.resource.data.get('email', '') == request.auth.token.get('email', '')
        // Consent is an AUDIT RECORD. The update rule below pins both consent
        // fields; without a matching guard HERE the subject just writes the
        // record at create time instead, back-dating "when I agreed" to any
        // value they like — which is the half that matters under UK GDPR.
        //
        // `policyAgreedAt` is therefore pinned to the server's own clock
        // (`request.time` is what a client `serverTimestamp()` resolves to).
        //
        // `policyVersion` is deliberately NOT pinned to a literal here. The
        // re-consent gate compares it for INEQUALITY against
        // CURRENT_POLICY_VERSION, so a bogus or far-future value TRIGGERS the
        // gate rather than escaping it — there is nothing to defend. Pinning a
        // version string in this file would instead mean every policy bump had
        // to ship a rules deploy in lockstep or ALL new registrations would
        // fail closed. Given rules already deploy out of band, that failure
        // mode is far worse than the thing it would prevent.
        && (
          !('policyAgreedAt' in request.resource.data)
          || request.resource.data.policyAgreedAt == request.time
        )
        // `uniEmailVerifiedAt` is a trusted signal (gates uni-email ownership +
        // the admin "verified" badge). It is stamped SERVER-SIDE from the
        // server-only `emailVerifications` record (via /api/verify-email/reconcile
        // right after this create), never from the client — so a self-created doc
        // must not seed it, or a caller could forge "verified" for an address
        // they don't own and squat a victim's real uni email.
        && !('uniEmailVerifiedAt' in request.resource.data.get('profile', {}))
        && smallEnough();

      // Self-update: role, tracks, permissions and suRecognised all unchanged.
      // (These are admin-only; a user editing their own profile must not be able
      //  to flip or clear any of them. suRecognised in particular is a trust
      //  boundary; leaving it unlocked would let a non-SU committee member
      //  self-grant access to all member PII.)
      // Also: self-changes to `profile.universityEmail` are rate-limited if
      // the address was previously suppressed — the webhook stamps a lock
      // timestamp on the user doc, and this rule rejects further changes
      // until that time has passed. Admins bypass via the `isAdmin()` branch.
      allow update: if (isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.get('tracks', []) == resource.data.get('tracks', [])
            && request.resource.data.get('permissions', {}) == resource.data.get('permissions', {})
            && request.resource.data.get('suRecognised', false) == resource.data.get('suRecognised', false)
            // `email` is PROVEN-inbox state, not a profile field. Downstream it
            // is trusted as an address the user demonstrably controls:
            // /api/subscriptions/sync marks rows `confirmed` from it with no
            // click, the newsletter sender resolves recipients from it, and
            // /api/admin/application-emails/send mails it. Leaving it writable
            // let any self-registered account point it at a stranger and have
            // the server treat that stranger's inbox as opted in.
            // No legitimate client flow rewrites it: the profile form touches
            // only `profile.*`, and registration sets it once at create from
            // the Auth token. Pinning it costs nothing and closes three paths.
            && request.resource.data.get('email', '') == resource.data.get('email', '')
            // Consent is an AUDIT RECORD, so the subject must not be able to
            // write it. Both fields were absent from these rules entirely, and
            // with no keys().hasOnly() a member could bump `policyVersion` to
            // skip the re-consent gate AND fabricate the `policyAgreedAt` that
            // says they agreed — the half that matters under UK GDPR.
            // Re-consent is server-stamped (/api/account/reconsent, Admin SDK,
            // which bypasses these rules), so locking self-updates costs no
            // legitimate flow. The initial value is still written once at
            // registration, by the create rule above (signInWithGoogle.ts).
            // Note this sits INSIDE the self-update disjunct on purpose: the
            // isAdmin() branch above is unaffected.
            // The VERSION is the security property — claiming to have accepted
            // a policy you never saw is the forgery, and skipping the
            // re-consent gate is the escalation. It is pinned outright.
            && request.resource.data.get('policyVersion', '')
              == resource.data.get('policyVersion', '')
            // The timestamp may only stay put or be re-stamped to the server's
            // own clock, never back-dated to a value of the caller's choosing.
            // `request.time` is what a client `serverTimestamp()` resolves to,
            // which is what makes the registration RETRY work: completeRegistration
            // writes an unmerged setDoc, so a second attempt re-sends
            // policyAgreedAt for the SAME version. Requiring strict equality
            // here denied that retry outright — an over-tightening that would
            // have stranded anyone whose first attempt failed.
            && (
              request.resource.data.get('policyAgreedAt', null)
                == resource.data.get('policyAgreedAt', null)
              || request.resource.data.get('policyAgreedAt', null) == request.time
            )
            && (
              request.resource.data.get(['profile', 'universityEmail'], '')
                == resource.data.get(['profile', 'universityEmail'], '')
              || resource.data.get(['profile', 'universityEmailLockUntil'], request.time)
                <= request.time
            )
            // `uniEmailVerifiedAt` is server-authoritative (see the create rule)
            // and is BOUND to the address it attests to. A self-update may only
            // CLEAR it (the profile form does this on any uni-email change) or
            // leave it untouched WHILE the uni email is also unchanged. It may
            // never be introduced, changed, OR kept across an email change —
            // keeping a stale stamp while repointing `universityEmail` to a
            // victim's address would forge ownership of that address (the admin
            // "verified" badge + the findVerifiedUniEmailOwner squat). The server
            // (Admin SDK, which bypasses these rules) is the only writer of a
            // truthy stamp, always in lockstep with the verified address.
            && (
              !('uniEmailVerifiedAt' in request.resource.data.get('profile', {}))
              || (
                request.resource.data.get(['profile', 'uniEmailVerifiedAt'], null)
                  == resource.data.get(['profile', 'uniEmailVerifiedAt'], null)
                && request.resource.data.get(['profile', 'universityEmail'], '')
                  == resource.data.get(['profile', 'universityEmail'], '')
              )
            )))
        && smallEnough();

      allow delete: if isAdmin();
    }

    // === collaborators ===
    // External collaborator applications (people NOT at the University of
    // Nottingham). A SEPARATE collection from `users` so the member governance /
    // trust model is untouched. Doc id is "<name-slug>__<uid>"; the read gate
    // keys off the stored `uid` field, NOT the doc-id path param. All writes go
    // through server routes (Admin SDK) — clients never write — so this is
    // locked like subscriptions / eventRsvps; the create-route is the validation
    // + rate-limit boundary. Admins manage; a collaborator reads only their own
    // application (powers the limited collaborator area).
    match /collaborators/{docId} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.uid);
      allow write: if false;
    }

    // === projects ===
    match /projects/{projectId} {
      allow read:   if hasRole(['member', 'committee', 'admin']);
      allow write:  if isAdmin();
    }

    // === tasks ===
    //
    // Visibility model:
    // - 'committee' visibility: every SU-recognised committee member + admin
    //   sees the task on the board. Non-SU committee see it only if they are
    //   on it (completer/reviewer).
    // - 'assignees-only': only the listed completers/reviewers + admins see it.
    //   Admins-only toggle (committee cannot create OR flip to assignees-only).
    // - Members (and non-SU committee) can create tasks ONLY for themselves
    //   with source='personal' and visibility='assignees-only' (powers the
    //   "quick add" on My Work).
    //
    // Sequential subtask gating (blockedBy) is enforced client-side, not here —
    // evaluating it would mean scanning two arrays on every write. Inside a
    // committee-visibility task, everyone in the thread is trusted.
    match /tasks/{taskId} {
      function taskData()    { return resource.data; }
      function isCompleter() {
        return isSignedIn() && request.auth.uid in taskData().completerUids;
      }
      function isReviewer() {
        return isSignedIn() && request.auth.uid in taskData().reviewerUids;
      }
      function isTaskCreator() {
        return isSignedIn() && request.auth.uid == taskData().creatorUid;
      }
      // Committee powers on tasks (seeing every committee-visibility task and
      // creating/managing them) are limited to SU-recognised committee plus
      // admins. Non-SU committee collaborate only on tasks they are explicitly
      // added to, via the isCompleter()/isReviewer() branches.
      function isCommittee() { return isAdmin() || isSuCommittee(); }
      function visibleToMe() {
        return isAdmin()
          || (isCommittee() && taskData().visibility == 'committee')
          || isCompleter()
          || isReviewer();
      }

      allow read: if visibleToMe();

      allow create: if isSignedIn()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.subtasks.size() <= 50
        && request.resource.data.completerUids.size() <= 10
        && request.resource.data.reviewerUids.size() <= 5
        && request.resource.data.get('blocks', []).size() <= 10
        && (
          isCommittee()
          || (
            request.resource.data.source == 'personal'
            && request.resource.data.visibility == 'assignees-only'
            && request.resource.data.completerUids.hasOnly([request.auth.uid])
            && request.resource.data.completerUids.size() == 1
            && request.resource.data.reviewerUids.size() == 0
          )
        );

      // Admin = full control (incl. flipping visibility).
      // SU committee = full control on committee-visibility tasks but CANNOT
      // flip visibility to 'assignees-only' (admin-only).
      // Completers + reviewers = narrow field-level writes (status/subtasks/
      // counters/blocks/blockConsents). Including reviewers here lets a
      // reviewer tick their review subtask even if they're not on the
      // completer list. `blocks` + `blockConsents` are in the narrow band
      // because completers drive the lock-in ritual (and that ritual may
      // atomically flip `block.sealState` to 'sealed' on the Nth consent).
      // Fine-grained "only-own-uid" consent-edit enforcement is client-side
      // — arrays-inside-maps diffing is too costly in rules.
      allow update: if
        isAdmin()
        || (
          isCommittee()
          && taskData().visibility == 'committee'
          && request.resource.data.visibility == 'committee'
          && request.resource.data.subtasks.size() <= 50
          && request.resource.data.completerUids.size() <= 10
          && request.resource.data.reviewerUids.size() <= 5
          && request.resource.data.get('blocks', []).size() <= 10
        )
        || (
          (isCompleter() || isReviewer())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'subtasks', 'subtaskStats', 'updatedAt',
            'completedAt', 'attachmentCount', 'commentCount',
            'blocks', 'blockConsents'
          ])
          && request.resource.data.subtasks.size() <= 50
          && request.resource.data.get('blocks', []).size() <= 10
        )
        // Creator of a personal task can edit it freely.
        // `reviewerUids` is pinned empty for the same reason the CREATE rule
        // requires size() == 0: a personal task is a private to-do for one
        // person. Without this the create-time check was trivially sidestepped
        // — create clean, then UPDATE reviewerUids to a list of strangers —
        // and naming someone as a reviewer both puts the task on their board
        // (isReviewer() satisfies visibleToMe()) and makes them a recipient of
        // the notify / send-for-review routes. That turned a private to-do
        // into a way to push attacker-chosen text at arbitrary members.
        || (
          taskData().source == 'personal'
          && isTaskCreator()
          && request.resource.data.visibility == 'assignees-only'
          && request.resource.data.source == 'personal'
          && request.resource.data.completerUids.hasOnly([request.auth.uid])
          && request.resource.data.reviewerUids.size() == 0
        );

      allow delete: if isAdmin()
        || (isCommittee() && taskData().visibility == 'committee' && isTaskCreator())
        || (taskData().source == 'personal' && isTaskCreator());

      // --- comments ---
      match /comments/{commentId} {
        function parent() {
          return get(/databases/$(database)/documents/tasks/$(taskId)).data;
        }
        function canAccessParent() {
          return isAdmin()
            || (isSuCommittee() && parent().visibility == 'committee')
            || request.auth.uid in parent().completerUids
            || request.auth.uid in parent().reviewerUids;
        }
        allow read: if canAccessParent();
        allow create: if canAccessParent()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.bodyMarkdown.size() <= 2000
          && request.resource.data.get('mentions', []).size() <= 20;
        // Editing your own comment ALSO requires still being able to reach the
        // task. Checking authorship alone let someone rotated off a task keep
        // permanent rewrite rights inside a thread they can no longer read —
        // silently altering the record for everyone still on it. Same oversight
        // class as the activity-log create rule.
        // `mentions` is capped because /api/tasks/[id]/notify emails every uid
        // in this array; an unbounded list is an unbounded send.
        allow update: if canAccessParent()
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'bodyMarkdown', 'editedAt', 'deleted', 'mentions'
          ])
          && request.resource.data.bodyMarkdown.size() <= 2000
          && request.resource.data.get('mentions', []).size() <= 20;
        allow delete: if isAdmin();
      }

      // --- activity log (append-only; no client updates/deletes) ---
      match /activity/{entryId} {
        function parent() {
          return get(/databases/$(database)/documents/tasks/$(taskId)).data;
        }
        function canAccessParent() {
          return isAdmin()
            || (isSuCommittee() && parent().visibility == 'committee')
            || request.auth.uid in parent().completerUids
            || request.auth.uid in parent().reviewerUids;
        }
        allow read: if canAccessParent();
        // `canAccessParent()` was defined here and used for read but NOT for
        // create, while the sibling comments/attachments blocks gate create on
        // it — an oversight that let any signed-in account (a brand-new
        // `pending` one included) append arbitrary text to the activity log of
        // a task it cannot even read, or to a task id that does not exist.
        // Every legitimate client write batches this alongside an update to a
        // task the actor can already reach, and canAccessParent() admits
        // everyone the task update rule does, so this closes the hole without
        // narrowing a real flow.
        allow create: if canAccessParent()
          && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }

      // --- attachments metadata ---
      match /attachments/{attachmentId} {
        function parent() {
          return get(/databases/$(database)/documents/tasks/$(taskId)).data;
        }
        function canAccessParent() {
          return isAdmin()
            || (isSuCommittee() && parent().visibility == 'committee')
            || request.auth.uid in parent().completerUids
            || request.auth.uid in parent().reviewerUids;
        }
        allow read: if canAccessParent();
        // `storagePath` MUST be confined to this task's own folder. Three
        // server routes (tasks/[id]/delete, delete-block, delete-subtask) read
        // this field and pass it to bucket.file(path).delete() through the
        // Admin SDK, which bypasses storage.rules entirely — so an unconstrained
        // value here meant any signed-in account could point it at
        // `event-images/...` or another task's blobs, delete its own throwaway
        // task, and have the server destroy arbitrary objects anywhere in the
        // bucket. The routes now validate the prefix too; this is the other half.
        allow create: if canAccessParent()
          && request.resource.data.uploadedByUid == request.auth.uid
          // `[^/]+$` rather than `.*`: a trailing `.*` still matched
          // `tasks/<id>/<att>/../../../newsletter-images/x.png`, which resolves
          // straight back out of the folder. One path segment, no traversal.
          && request.resource.data.get('storagePath', '')
               .matches('^tasks/' + taskId + '/' + attachmentId + '/[^/]+$');
        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.uploadedByUid == request.auth.uid);
        allow update: if false;
      }
    }

    // === taskTemplates ===
    // Person-agnostic task-structure templates (subtask titles, blockedBy graph,
    // role hints). Admins CRUD; committee + admin can read + instantiate into
    // new tasks. Templates never store user UIDs — the creator picks completers
    // and reviewers at task-creation time.
    match /taskTemplates/{templateId} {
      allow read: if hasRole(['committee', 'admin']);
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.subtasks.size() <= 50;
      allow delete: if isAdmin();
    }

    // === credentials (committee only, client-side encrypted) ===
    // THE FEATURE IS NOT BUILT (see CLAUDE.md > What's not built yet): there is
    // no feature code, only a placeholder page. Until it exists these rules
    // should grant nothing — a deployed grant for an unbuilt feature is pure
    // attack surface. Previously `allow read, write: if hasRole([...])` gave
    // EVERY committee account, including non-SU committee (whom the trust model
    // scopes to tasks they are named on), unvalidated and uncapped read, write
    // and delete: free arbitrary storage and write amplification on a
    // no-billing project.
    // When the credentials feature lands, add a validated create/update rule
    // here alongside it, gated on isSuCommittee() rather than bare role.
    match /credentials/{entryId} {
      allow read, write: if false;
    }
    match /credentialsMeta/{id} {
      allow read:  if isAdmin() || isSuCommittee();
      allow write: if false;
    }

    // === bookings ===
    // No booking feature writes from the client yet. The old
    // `create: if isSignedIn()` was unvalidated: any signed-in user could
    // forge booking docs (arbitrary host/guest uids, no size cap, naming
    // someone else as host so it surfaced in their view). All client writes
    // are locked; when the booking feature lands its writes go through the
    // Admin SDK (which bypasses rules) and a validated create rule is added
    // here alongside it.
    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (isSignedIn() && (request.auth.uid == resource.data.hostUid
                          || request.auth.uid == resource.data.guestUid));
      allow create, update, delete: if false;
    }

    // === news (public read, admin write) ===
    match /news/{slug} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // === newsletterDrafts ===
    // Drafters (permissions.draftNewsletter) and approvers (permissions.approveNewsletter)
    // get access; admin is always in. Final send happens server-side via a
    // privileged API route — clients never set status == 'sent' directly.
    match /newsletterDrafts/{draftId} {
      function me() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function hasPerm(key) {
        return isSignedIn()
          && (me().role == 'admin' || me().get(['permissions', key], false) == true);
      }
      function canDraft()   { return hasPerm('draftNewsletter');   }
      function canApprove() { return hasPerm('approveNewsletter'); }

      allow read:   if canDraft() || canApprove();
      allow create: if canDraft()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'draft';
      // Per-document scoping, mirroring what PR #225 did for `events`. This
      // block had none: `draftNewsletter` is a GLOBAL permission a plain member
      // can hold, so any drafter could edit ANY draft, self-approve their own,
      // and — the sharp end — silently rewrite the subject and body of a draft
      // ALREADY at status 'approved'. The approver signs off on one newsletter
      // and the send route ships a different one to the whole list.
      function isOwnDraft() {
        return isSignedIn() && resource.data.get('authorUid', '') == request.auth.uid;
      }
      allow update: if isAdmin()
        || (
          (canApprove() || (canDraft() && isOwnDraft()))
          // 'sent' transitions only happen via admin SDK on the server.
          && request.resource.data.status != 'sent'
          && resource.data.get('status', 'draft') != 'sent'
          // An APPROVED draft is frozen to its author: re-opening it for edits
          // requires the approve permission, so content cannot change after
          // sign-off without a second pair of eyes.
          && (
            resource.data.get('status', 'draft') != 'approved'
            || canApprove()
          )
          && (
            // Content edits that leave the workflow state alone.
            request.resource.data.status == resource.data.status
            // Author self-service: park as draft, or send for review.
            || (isOwnDraft() && request.resource.data.status in ['draft', 'pending'])
            // Approving or rejecting is the two-person half of review.
            || canApprove()
          )
        );
      allow delete: if isAdmin()
        || (canDraft() && resource.data.authorUid == request.auth.uid);
    }

    // === events ===
    // Parallel to newsletterDrafts — orthogonal permissions.
    // Drafters can create/read/update; approvers can read/update; admins always in.
    // The whole committee can read every event: the events area is open to all
    // committee members, who plan and collaborate there even without the
    // draft/approve permissions. Published events are also readable by any
    // signed-in user (members see them on the authed events list). Public
    // visibility for unauthenticated readers is served via a server route
    // using the admin SDK. 'published' transitions only happen via the admin SDK.
    match /events/{eventId} {
      function me() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function hasPerm(key) {
        return isSignedIn()
          && (me().role == 'admin' || me().get(['permissions', key], false) == true);
      }
      function canDraft()   { return hasPerm('draftEvent');   }
      function canApprove() { return hasPerm('approveEvent'); }
      // A per-event collaborator: a committee member the author or an admin
      // explicitly added so they can edit this specific event.
      function isCollaborator() {
        return isSignedIn()
          && request.auth.uid in resource.data.get('collaboratorUids', []);
      }

      allow read: if canDraft() || canApprove()
        || hasRole(['committee', 'admin'])
        || (isSignedIn() && resource.data.status == 'published');
      allow create: if canDraft()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'draft';
      // Per-document scoping. `draftEvent` is a GLOBAL permission a plain
      // member can hold, so without an ownership test it granted write access
      // to EVERY event — including cancelling someone else's published one,
      // because only the INCOMING status was ever checked. A collaborator is
      // already per-event by construction (they are named on the doc).
      function isOwnEvent() {
        return isSignedIn() && resource.data.get('authorUid', '') == request.auth.uid;
      }
      // Fields nobody inside the branches below may rewrite from the client.
      // The per-document scoping added in PR #225 decided WHO may edit and in
      // WHICH states, but pinned nothing about WHAT — so a named collaborator
      // (who may be a plain member with no permissions at all, since
      // isCollaborator() only tests membership of collaboratorUids) could seize
      // `authorUid`, add accomplices to `collaboratorUids`, or rewrite the
      // rsvpCount* counters that drive capacity and waitlist decisions.
      // Ownership and attendance are the server's to change:
      // /api/events/[id]/collaborators manages the roster and the RSVP routes
      // own the counters, all Admin SDK.
      //
      // `visibility` is deliberately NOT pinned. The editor legitimately
      // patches it (eventMutations.ts:112) while drafting, and the outer rule
      // already refuses any client write once the STORED status is published
      // or cancelled — so a members-only event cannot be flipped public while
      // it is actually live. Pinning it would break a real flow to prevent
      // nothing.
      function pinnedFieldsUnchanged() {
        return request.resource.data.get('authorUid', '') == resource.data.get('authorUid', '')
          && request.resource.data.get('collaboratorUids', [])
               == resource.data.get('collaboratorUids', [])
          && request.resource.data.get('rsvpCountPending', 0)
               == resource.data.get('rsvpCountPending', 0)
          && request.resource.data.get('rsvpCountConfirmed', 0)
               == resource.data.get('rsvpCountConfirmed', 0)
          && request.resource.data.get('rsvpCountWaitlisted', 0)
               == resource.data.get('rsvpCountWaitlisted', 0);
      }
      allow update: if isAdmin()
        || (
          (canApprove() || isCollaborator() || (canDraft() && isOwnEvent()))
          && pinnedFieldsUnchanged()
          // An APPROVED event is frozen to its author for the same reason an
          // approved newsletter is: otherwise the approver reviews one event
          // and the publish route ships another. Re-opening it needs canApprove().
          && (
            resource.data.get('status', 'draft') != 'approved'
            || canApprove()
          )
          // Once an event is LIVE it is server territory: post-publish edits go
          // through /api/events/[id]/update (which diffs and sends the change
          // notices) and cancellation through .../cancel, both Admin SDK. The
          // STORED status is what matters here — testing only the incoming one
          // was the original bug, and checking it alone still let an author
          // quietly unpublish their own live event by reverting it to draft.
          && resource.data.get('status', 'draft') != 'published'
          && resource.data.get('status', 'draft') != 'cancelled'
          && request.resource.data.status != 'published'
          && (
            // Content edits that leave the workflow state alone.
            request.resource.data.status == resource.data.status
            // Author/collaborator self-service: park as draft, or send for review.
            || ((isOwnEvent() || isCollaborator())
                && request.resource.data.status in ['draft', 'pending'])
            // Every state that CONFERS or WITHDRAWS publication — approved,
            // rejected, cancelled — requires the approve permission. That is
            // the two-person half of review: holding `draftEvent` alone must
            // never move an event through it, not even your own.
            || canApprove()
          )
        );
      // Deletion goes through /api/events/[id]/delete (Admin SDK), which
      // cascades the event's RSVPs and images before removing the doc. Client
      // delete is withdrawn for the same reason `registrations` locks it: a
      // client can only ever delete the event document — `eventRsvps` denies
      // client writes outright — so a direct delete stranded every attendee's
      // name, email and free-text answers with no event left to justify them.
      // A forensic scan found exactly that on production (6 rows, 6 images).
      // The route re-implements the authorisation this rule used to express.
      allow delete: if false;
    }

    // === applicationEmailTemplates ===
    // Admin-edited boilerplates for lifecycle emails (submitted/approved/rejected).
    // Server send routes use the admin SDK and bypass these rules; the rules
    // below are for the admin editor client.
    match /applicationEmailTemplates/{templateId} {
      allow read:  if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.recipients in ['both', 'google', 'university']
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 200;
    }

    // === emailVerifications ===
    // One doc per outstanding magic-link uni-email verification. Created by
    // the server-side /api/verify-email/send route; mutated by the
    // /api/verify-email/confirm route (admin SDK in both cases). Clients are
    // allowed to READ the doc they initiated (so the register tab can
    // onSnapshot for `verifiedAt != null`), but cannot write — writes go
    // through the signed-token endpoints only.
    match /emailVerifications/{tokenId} {
      allow read: if isSignedIn()
        && request.auth.uid == resource.data.authUid;
      allow write: if false;
    }

    // === suppressedEmails ===
    // Populated by the SES→SNS bounce/complaint webhook via the admin SDK.
    // No client access — the send routes that consult this list also use the
    // admin SDK, so rules below stay fully locked.
    match /suppressedEmails/{docId} {
      allow read, write: if false;
    }

    // === emailSends ===
    // Append-only send log populated by sendEmail() on success and updated
    // by the SES→SNS webhook on bounce/complaint. Admin SDK only — the admin
    // deliverability dashboard reads it through a server route.
    match /emailSends/{docId} {
      allow read, write: if false;
    }

    // === registrations ===
    // One durable doc per account created via the email-only register route
    // (keyed by Auth uid). Tracks emailVerified / passwordSet → the admin orphan
    // tracker + suspicious-signup flagger. All writes are Admin SDK (the
    // register / verify / password-set routes); the admin tab reads it through a
    // server route. Rows hold email PII, so client access is fully locked — same
    // posture as emailSends / suppressedEmails.
    //
    // Deletion (self-service unfinished-account delete, admin delete, and the
    // collaborator/member deletes) ALSO runs server-side via the shared account
    // cascade (deleteAccountCascade, Admin SDK). Client deletes stay locked on
    // purpose: a client deleting just this row — or just its users doc — would
    // skip the Auth + cross-collection teardown and recreate the ghost-row bug.
    match /registrations/{uid} {
      allow read, write: if false;
    }

    // === signupMetrics ===
    // Bounded daily signup-outcome counters (one doc per UTC day) powering the
    // reCAPTCHA-fail-rate signal. Admin SDK increments per attempt; the admin
    // summary route reads them. Fully locked to clients.
    match /signupMetrics/{date} {
      allow read, write: if false;
    }

    // === subscriptions ===
    // Junction collection: each row is one (recipient, channel) pair. All
    // mutations go through server routes (admin SDK) — clients never write.
    // Reads: admins see everything; signed-in users see only their own rows
    // (audience == "user" && audienceId == auth.uid), powering the member
    // settings UI.
    match /subscriptions/{docId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && resource.data.audience == 'user'
            && resource.data.audienceId == request.auth.uid);
      allow write: if false;
    }

    // === subscriptionEvents ===
    // Append-only audit log: one doc per subscription action. All writes
    // go through server routes (admin SDK), clients never write. Reads
    // are admin-only; the admin Subscriptions tab streams the collection
    // to show per-row history.
    match /subscriptionEvents/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // === impersonations ===
    // Audit log of admin "view as" sessions. One doc per (start, end) pair,
    // written entirely by the /api/admin/impersonate* routes via Admin SDK.
    // Clients never write here; admins can read the log for a future
    // impersonations review tab.
    match /impersonations/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // === eventRsvps ===
    // RSVPs are attendee PII - never public read. All writes go through the
    // server route `/api/events/[id]/rsvp` (admin SDK), so rules are a safety
    // net, not the main gate. Reads: SU-recognised committee and admins only -
    // the same trust boundary as member PII and the committee task board. A
    // non-SU event author can plan the event but cannot see who signed up.
    match /eventRsvps/{rsvpId} {
      allow read: if isAdmin() || isSuCommittee();
      // No direct client writes; the API route uses the admin SDK.
      allow create, update, delete: if false;
    }

    // === publicConfig ===
    // World-readable runtime config. Today that is ONLY the site-notice doc,
    // and the match is pinned to that single doc id ON PURPOSE: `allow read`
    // also grants `list`, so a {docId} wildcard would make every future doc
    // dropped into this collection world-readable AND enumerable. If the
    // collection ever grows, add another pinned block per doc.
    // Nothing sensitive may land here — audit fields (who flipped it) go in
    // `config/siteNoticeAudit`, which has no match block and stays
    // default-deny. All writes go through /api/admin/site-notice (Admin SDK).
    match /publicConfig/siteNotice {
      allow read: if true;
      allow write: if false;
    }

    // === maintenanceLog ===
    // Public history of maintenance notices powering the /status page — one
    // doc per banner-visible episode, written ONLY by /api/admin/site-notice
    // (Admin SDK). Unlike publicConfig this wildcard is world-readable AND
    // enumerable ON PURPOSE (owner decision 2026-08-01): the whole point is a
    // public log. Nothing sensitive may ever be written here — entries carry
    // only admin-authored notice copy, level, times and pause flags.
    match /maintenanceLog/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    // === adminLocks ===
    // Soft, FAIL-OPEN coordination locks for the admin console. Two shapes,
    // distinguished by doc id:
    //   page__<key>       one-admin-at-a-time presence lease on an admin page.
    //   useredit__<uid>   "this member's details are under maintenance" while an
    //                     admin edits them.
    // Only admins acquire / heartbeat / release a lock. A member may READ the
    // useredit lock that targets THEM (doc id useredit__<their uid>) to show the
    // maintenance notice, and post a message to it, but never create/modify a
    // lock. The id-pattern check (not resource.data) lets a member read their own
    // lock doc even when it does not exist yet (an absent doc has no resource).
    match /adminLocks/{lockId} {
      allow read: if isSignedIn()
        && (isAdmin() || lockId == ('useredit__' + request.auth.uid));
      allow create, update, delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isSignedIn()
          && (isAdmin() || lockId == ('useredit__' + request.auth.uid));
        // Author can only post as themselves, on a page lock (admins) or their
        // own user-edit lock. Cap size + fix the shape so a client can't store
        // oversized / arbitrary message docs.
        allow create: if isSignedIn()
          && request.resource.data.fromUid == request.auth.uid
          && (isAdmin() || lockId == ('useredit__' + request.auth.uid))
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          // `fromName` needs a cap too. hasOnly() fixes WHICH keys may appear,
          // not how big they are, so with only `text` bounded a member could
          // write ~1MB documents to their own lock, unbounded in number.
          && request.resource.data.get('fromName', '') is string
          && request.resource.data.get('fromName', '').size() <= 120
          && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'text', 'createdAt']);
        allow update, delete: if false;
      }
    }
  }
}
