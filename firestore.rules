rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn()   { return request.auth != null; }
    function userRole()     { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function hasRole(roles) { return isSignedIn() && userRole() in roles; }
    function isAdmin()      { return hasRole(['admin']); }

    // SU-recognised committee: committee members the Students' Union formally
    // recognises. They are trusted with member PII (the users collection) and
    // full committee task powers. Non-SU committee are scoped to the tasks
    // they are explicitly added to. `suRecognised` is admin-set and locked
    // against self-service edits in the users create/update rules below.
    function isSuCommittee() {
      return hasRole(['committee'])
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('suRecognised', false) == true;
    }

    // Keep the user doc under a reasonable size cap as a DoS guard;
    // detailed shape validation happens in the React forms.
    function smallEnough() {
      return request.resource.data.size() <= 30
        && (!('profile' in request.resource.data)
            || request.resource.data.profile.size() <= 30);
    }

    // === users ===
    match /users/{uid} {
      // Member PII: emails, university email, application motivation, roles.
      // Readable only by SU-recognised committee and admins, plus each user
      // reading their own doc. A plain signed-in account (including one that
      // has signed in but not yet registered) can no longer enumerate the
      // membership. Non-admin task views resolve names via a server route.
      allow read: if isAdmin() || isSuCommittee()
        || (isSignedIn() && request.auth.uid == uid);

      // Self-create: must use own uid and start as 'pending'. `tracks`,
      // `permissions` and `suRecognised` are all admin-controlled. A
      // self-created doc must not seed any of them (the signup flow writes
      // none). Without these guards a user could self-grant drafter
      // permissions or SU-committee trust at create time.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'pending'
        && !('tracks' in request.resource.data)
        && !('permissions' in request.resource.data)
        && !('suRecognised' in request.resource.data)
        && smallEnough();

      // Self-update: role, tracks, permissions and suRecognised all unchanged.
      // (These are admin-only; a user editing their own profile must not be able
      //  to flip or clear any of them. suRecognised in particular is a trust
      //  boundary; leaving it unlocked would let a non-SU committee member
      //  self-grant access to all member PII.)
      // Also: self-changes to `profile.universityEmail` are rate-limited if
      // the address was previously suppressed — the webhook stamps a lock
      // timestamp on the user doc, and this rule rejects further changes
      // until that time has passed. Admins bypass via the `isAdmin()` branch.
      allow update: if (isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.get('tracks', []) == resource.data.get('tracks', [])
            && request.resource.data.get('permissions', {}) == resource.data.get('permissions', {})
            && request.resource.data.get('suRecognised', false) == resource.data.get('suRecognised', false)
            && (
              request.resource.data.get(['profile', 'universityEmail'], '')
                == resource.data.get(['profile', 'universityEmail'], '')
              || resource.data.get(['profile', 'universityEmailLockUntil'], request.time)
                <= request.time
            )))
        && smallEnough();

      allow delete: if isAdmin();
    }

    // === projects ===
    match /projects/{projectId} {
      allow read:   if hasRole(['member', 'committee', 'admin']);
      allow write:  if isAdmin();
    }

    // === tasks ===
    //
    // Visibility model:
    // - 'committee' visibility: every SU-recognised committee member + admin
    //   sees the task on the board. Non-SU committee see it only if they are
    //   on it (completer/reviewer).
    // - 'assignees-only': only the listed completers/reviewers + admins see it.
    //   Admins-only toggle (committee cannot create OR flip to assignees-only).
    // - Members (and non-SU committee) can create tasks ONLY for themselves
    //   with source='personal' and visibility='assignees-only' (powers the
    //   "quick add" on My Work).
    //
    // Sequential subtask gating (blockedBy) is enforced client-side, not here —
    // evaluating it would mean scanning two arrays on every write. Inside a
    // committee-visibility task, everyone in the thread is trusted.
    match /tasks/{taskId} {
      function taskData()    { return resource.data; }
      function isCompleter() {
        return isSignedIn() && request.auth.uid in taskData().completerUids;
      }
      function isReviewer() {
        return isSignedIn() && request.auth.uid in taskData().reviewerUids;
      }
      function isTaskCreator() {
        return isSignedIn() && request.auth.uid == taskData().creatorUid;
      }
      // Committee powers on tasks (seeing every committee-visibility task and
      // creating/managing them) are limited to SU-recognised committee plus
      // admins. Non-SU committee collaborate only on tasks they are explicitly
      // added to, via the isCompleter()/isReviewer() branches.
      function isCommittee() { return isAdmin() || isSuCommittee(); }
      function visibleToMe() {
        return isAdmin()
          || (isCommittee() && taskData().visibility == 'committee')
          || isCompleter()
          || isReviewer();
      }

      allow read: if visibleToMe();

      allow create: if isSignedIn()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.subtasks.size() <= 50
        && request.resource.data.completerUids.size() <= 10
        && request.resource.data.reviewerUids.size() <= 5
        && request.resource.data.get('blocks', []).size() <= 10
        && (
          isCommittee()
          || (
            request.resource.data.source == 'personal'
            && request.resource.data.visibility == 'assignees-only'
            && request.resource.data.completerUids.hasOnly([request.auth.uid])
            && request.resource.data.completerUids.size() == 1
            && request.resource.data.reviewerUids.size() == 0
          )
        );

      // Admin = full control (incl. flipping visibility).
      // SU committee = full control on committee-visibility tasks but CANNOT
      // flip visibility to 'assignees-only' (admin-only).
      // Completers + reviewers = narrow field-level writes (status/subtasks/
      // counters/blocks/blockConsents). Including reviewers here lets a
      // reviewer tick their review subtask even if they're not on the
      // completer list. `blocks` + `blockConsents` are in the narrow band
      // because completers drive the lock-in ritual (and that ritual may
      // atomically flip `block.sealState` to 'sealed' on the Nth consent).
      // Fine-grained "only-own-uid" consent-edit enforcement is client-side
      // — arrays-inside-maps diffing is too costly in rules.
      allow update: if
        isAdmin()
        || (
          isCommittee()
          && taskData().visibility == 'committee'
          && request.resource.data.visibility == 'committee'
          && request.resource.data.subtasks.size() <= 50
          && request.resource.data.completerUids.size() <= 10
          && request.resource.data.reviewerUids.size() <= 5
          && request.resource.data.get('blocks', []).size() <= 10
        )
        || (
          (isCompleter() || isReviewer())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'subtasks', 'subtaskStats', 'updatedAt',
            'completedAt', 'attachmentCount', 'commentCount',
            'blocks', 'blockConsents'
          ])
          && request.resource.data.subtasks.size() <= 50
          && request.resource.data.get('blocks', []).size() <= 10
        )
        // Creator of a personal task can edit it freely.
        || (
          taskData().source == 'personal'
          && isTaskCreator()
          && request.resource.data.visibility == 'assignees-only'
          && request.resource.data.source == 'personal'
          && request.resource.data.completerUids.hasOnly([request.auth.uid])
        );

      allow delete: if isAdmin()
        || (isCommittee() && taskData().visibility == 'committee' && isTaskCreator())
        || (taskData().source == 'personal' && isTaskCreator());

      // --- comments ---
      match /comments/{commentId} {
        function parent() {
          return get(/databases/$(database)/documents/tasks/$(taskId)).data;
        }
        function canAccessParent() {
          return isAdmin()
            || (isSuCommittee() && parent().visibility == 'committee')
            || request.auth.uid in parent().completerUids
            || request.auth.uid in parent().reviewerUids;
        }
        allow read: if canAccessParent();
        allow create: if canAccessParent()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.bodyMarkdown.size() <= 2000;
        allow update: if isSignedIn()
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'bodyMarkdown', 'editedAt', 'deleted', 'mentions'
          ])
          && request.resource.data.bodyMarkdown.size() <= 2000;
        allow delete: if isAdmin();
      }

      // --- activity log (append-only; no client updates/deletes) ---
      match /activity/{entryId} {
        function parent() {
          return get(/databases/$(database)/documents/tasks/$(taskId)).data;
        }
        function canAccessParent() {
          return isAdmin()
            || (isSuCommittee() && parent().visibility == 'committee')
            || request.auth.uid in parent().completerUids
            || request.auth.uid in parent().reviewerUids;
        }
        allow read: if canAccessParent();
        allow create: if isSignedIn()
          && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }

      // --- attachments metadata ---
      match /attachments/{attachmentId} {
        function parent() {
          return get(/databases/$(database)/documents/tasks/$(taskId)).data;
        }
        function canAccessParent() {
          return isAdmin()
            || (isSuCommittee() && parent().visibility == 'committee')
            || request.auth.uid in parent().completerUids
            || request.auth.uid in parent().reviewerUids;
        }
        allow read: if canAccessParent();
        allow create: if canAccessParent()
          && request.resource.data.uploadedByUid == request.auth.uid;
        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.uploadedByUid == request.auth.uid);
        allow update: if false;
      }
    }

    // === taskTemplates ===
    // Person-agnostic task-structure templates (subtask titles, blockedBy graph,
    // role hints). Admins CRUD; committee + admin can read + instantiate into
    // new tasks. Templates never store user UIDs — the creator picks completers
    // and reviewers at task-creation time.
    match /taskTemplates/{templateId} {
      allow read: if hasRole(['committee', 'admin']);
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.subtasks.size() <= 50;
      allow delete: if isAdmin();
    }

    // === credentials (committee only, client-side encrypted) ===
    match /credentials/{entryId} {
      allow read, write: if hasRole(['committee', 'admin']);
    }
    match /credentialsMeta/{id} {
      allow read:  if hasRole(['committee', 'admin']);
      allow write: if isAdmin();
    }

    // === bookings ===
    // No booking feature writes from the client yet. The old
    // `create: if isSignedIn()` was unvalidated: any signed-in user could
    // forge booking docs (arbitrary host/guest uids, no size cap, naming
    // someone else as host so it surfaced in their view). All client writes
    // are locked; when the booking feature lands its writes go through the
    // Admin SDK (which bypasses rules) and a validated create rule is added
    // here alongside it.
    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (isSignedIn() && (request.auth.uid == resource.data.hostUid
                          || request.auth.uid == resource.data.guestUid));
      allow create, update, delete: if false;
    }

    // === news (public read, admin write) ===
    match /news/{slug} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // === newsletterDrafts ===
    // Drafters (permissions.draftNewsletter) and approvers (permissions.approveNewsletter)
    // get access; admin is always in. Final send happens server-side via a
    // privileged API route — clients never set status == 'sent' directly.
    match /newsletterDrafts/{draftId} {
      function me() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function hasPerm(key) {
        return isSignedIn()
          && (me().role == 'admin' || me().get(['permissions', key], false) == true);
      }
      function canDraft()   { return hasPerm('draftNewsletter');   }
      function canApprove() { return hasPerm('approveNewsletter'); }

      allow read:   if canDraft() || canApprove();
      allow create: if canDraft()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'draft';
      allow update: if (canDraft() || canApprove())
        // 'sent' transitions only happen via admin SDK on the server.
        && request.resource.data.status != 'sent';
      allow delete: if isAdmin()
        || (canDraft() && resource.data.authorUid == request.auth.uid);
    }

    // === events ===
    // Parallel to newsletterDrafts — orthogonal permissions.
    // Drafters can create/read/update; approvers can read/update; admins always in.
    // The whole committee can read every event: the events area is open to all
    // committee members, who plan and collaborate there even without the
    // draft/approve permissions. Published events are also readable by any
    // signed-in user (members see them on the authed events list). Public
    // visibility for unauthenticated readers is served via a server route
    // using the admin SDK. 'published' transitions only happen via the admin SDK.
    match /events/{eventId} {
      function me() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function hasPerm(key) {
        return isSignedIn()
          && (me().role == 'admin' || me().get(['permissions', key], false) == true);
      }
      function canDraft()   { return hasPerm('draftEvent');   }
      function canApprove() { return hasPerm('approveEvent'); }
      // A per-event collaborator: a committee member the author or an admin
      // explicitly added so they can edit this specific event.
      function isCollaborator() {
        return isSignedIn()
          && request.auth.uid in resource.data.get('collaboratorUids', []);
      }

      allow read: if canDraft() || canApprove()
        || hasRole(['committee', 'admin'])
        || (isSignedIn() && resource.data.status == 'published');
      allow create: if canDraft()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'draft';
      allow update: if (canDraft() || canApprove() || isCollaborator())
        && request.resource.data.status != 'published';
      allow delete: if isAdmin()
        || (canDraft() && resource.data.authorUid == request.auth.uid
            && resource.data.status != 'published');
    }

    // === applicationEmailTemplates ===
    // Admin-edited boilerplates for lifecycle emails (submitted/approved/rejected).
    // Server send routes use the admin SDK and bypass these rules; the rules
    // below are for the admin editor client.
    match /applicationEmailTemplates/{templateId} {
      allow read:  if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.recipients in ['both', 'google', 'university']
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 200;
    }

    // === emailVerifications ===
    // One doc per outstanding magic-link uni-email verification. Created by
    // the server-side /api/verify-email/send route; mutated by the
    // /api/verify-email/confirm route (admin SDK in both cases). Clients are
    // allowed to READ the doc they initiated (so the register tab can
    // onSnapshot for `verifiedAt != null`), but cannot write — writes go
    // through the signed-token endpoints only.
    match /emailVerifications/{tokenId} {
      allow read: if isSignedIn()
        && request.auth.uid == resource.data.authUid;
      allow write: if false;
    }

    // === suppressedEmails ===
    // Populated by the SES→SNS bounce/complaint webhook via the admin SDK.
    // No client access — the send routes that consult this list also use the
    // admin SDK, so rules below stay fully locked.
    match /suppressedEmails/{docId} {
      allow read, write: if false;
    }

    // === emailSends ===
    // Append-only send log populated by sendEmail() on success and updated
    // by the SES→SNS webhook on bounce/complaint. Admin SDK only — the admin
    // deliverability dashboard reads it through a server route.
    match /emailSends/{docId} {
      allow read, write: if false;
    }

    // === subscriptions ===
    // Junction collection: each row is one (recipient, channel) pair. All
    // mutations go through server routes (admin SDK) — clients never write.
    // Reads: admins see everything; signed-in users see only their own rows
    // (audience == "user" && audienceId == auth.uid), powering the member
    // settings UI.
    match /subscriptions/{docId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && resource.data.audience == 'user'
            && resource.data.audienceId == request.auth.uid);
      allow write: if false;
    }

    // === subscriptionEvents ===
    // Append-only audit log: one doc per subscription action. All writes
    // go through server routes (admin SDK), clients never write. Reads
    // are admin-only; the admin Subscriptions tab streams the collection
    // to show per-row history.
    match /subscriptionEvents/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // === eventRsvps ===
    // RSVPs are attendee PII - never public read. All writes go through the
    // server route `/api/events/[id]/rsvp` (admin SDK), so rules are a safety
    // net, not the main gate. Reads: SU-recognised committee and admins only -
    // the same trust boundary as member PII and the committee task board. A
    // non-SU event author can plan the event but cannot see who signed up.
    match /eventRsvps/{rsvpId} {
      allow read: if isAdmin() || isSuCommittee();
      // No direct client writes; the API route uses the admin SDK.
      allow create, update, delete: if false;
    }
  }
}
