rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn()   { return request.auth != null; }
    function userRole()     { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function hasRole(roles) { return isSignedIn() && userRole() in roles; }
    function isAdmin()      { return hasRole(['admin']); }

    // SU-recognised committee: committee members the Students' Union formally
    // recognises. They are trusted with member PII (the users collection) and
    // full committee task powers. Non-SU committee are scoped to the tasks
    // they are explicitly added to. `suRecognised` is admin-set and locked
    // against self-service edits in the users create/update rules below.
    function isSuCommittee() {
      return hasRole(['committee'])
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('suRecognised', false) == true;
    }

    // Shared permission check for the courses feature: admin, or the named
    // key set true on the caller's own user doc. The newsletterDrafts and
    // events blocks each carry a LOCAL copy of this same helper — those
    // predate this one and are left duplicated on purpose (an inner function
    // shadows an outer one, so touching them buys nothing and risks two
    // proven blocks for zero behaviour change). New per-permission helpers
    // start here instead.
    function hasPerm(key) {
      return isSignedIn()
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
            || get(/databases/$(database)/documents/users/$(request.auth.uid))
                 .data.get(['permissions', key], false) == true);
    }
    function canDraftCourse()   { return hasPerm('draftCourse');   }
    function canApproveCourse() { return hasPerm('approveCourse'); }

    // Keep the user doc under a reasonable size cap as a DoS guard;
    // detailed shape validation happens in the React forms.
    function smallEnough() {
      return request.resource.data.size() <= 30
        && (!('profile' in request.resource.data)
            || request.resource.data.profile.size() <= 30);
    }

    // === users ===
    match /users/{uid} {
      // Member PII: emails, university email, application motivation, roles.
      // Readable only by SU-recognised committee and admins, plus each user
      // reading their own doc. A plain signed-in account (including one that
      // has signed in but not yet registered) can no longer enumerate the
      // membership. Non-admin task views resolve names via a server route.
      allow read: if isAdmin() || isSuCommittee()
        || (isSignedIn() && request.auth.uid == uid);

      // Self-create: must use own uid and start as 'pending'. `tracks`,
      // `permissions` and `suRecognised` are all admin-controlled. A
      // self-created doc must not seed any of them (the signup flow writes
      // none). Without these guards a user could self-grant drafter
      // permissions or SU-committee trust at create time.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'pending'
        && !('tracks' in request.resource.data)
        && !('permissions' in request.resource.data)
        && !('suRecognised' in request.resource.data)
        // `paidMembershipYears` is the admin-set paid-member tag ("2026/27"),
        // shown to admissions reviewers as a BADGE when they weigh a course
        // application. Self-seeding it at create would let any new account
        // walk into review wearing a paid-member badge it never earned —
        // same class of forgery as tracks/permissions above, guarded the
        // same way in both create and self-update.
        && !('paidMembershipYears' in request.resource.data)
        // `email` is the address the rest of the system treats as PROVEN: the
        // subscription sync marks rows `confirmed` from it without a click, the
        // newsletter sender resolves recipients from it, and the application
        // email routes mail it. It must therefore equal the address Firebase
        // Auth actually verified, never a value the client picked.
        && request.resource.data.get('email', '') == request.auth.token.get('email', '')
        // Consent is an AUDIT RECORD. The update rule below pins both consent
        // fields; without a matching guard HERE the subject just writes the
        // record at create time instead, back-dating "when I agreed" to any
        // value they like — which is the half that matters under UK GDPR.
        //
        // `policyAgreedAt` is therefore pinned to the server's own clock
        // (`request.time` is what a client `serverTimestamp()` resolves to).
        //
        // `policyVersion` is deliberately NOT pinned to a literal here. The
        // re-consent gate compares it for INEQUALITY against
        // CURRENT_POLICY_VERSION, so a bogus or far-future value TRIGGERS the
        // gate rather than escaping it — there is nothing to defend. Pinning a
        // version string in this file would instead mean every policy bump had
        // to ship a rules deploy in lockstep or ALL new registrations would
        // fail closed. Given rules already deploy out of band, that failure
        // mode is far worse than the thing it would prevent.
        && (
          !('policyAgreedAt' in request.resource.data)
          || request.resource.data.policyAgreedAt == request.time
        )
        // `uniEmailVerifiedAt` is a trusted signal (gates uni-email ownership +
        // the admin "verified" badge). It is stamped SERVER-SIDE from the
        // server-only `emailVerifications` record (via /api/verify-email/reconcile
        // right after this create), never from the client — so a self-created doc
        // must not seed it, or a caller could forge "verified" for an address
        // they don't own and squat a victim's real uni email.
        && !('uniEmailVerifiedAt' in request.resource.data.get('profile', {}))
        && smallEnough();

      // Self-update: role, tracks, permissions and suRecognised all unchanged.
      // (These are admin-only; a user editing their own profile must not be able
      //  to flip or clear any of them. suRecognised in particular is a trust
      //  boundary; leaving it unlocked would let a non-SU committee member
      //  self-grant access to all member PII.)
      // Also: self-changes to `profile.universityEmail` are rate-limited if
      // the address was previously suppressed — the webhook stamps a lock
      // timestamp on the user doc, and this rule rejects further changes
      // until that time has passed. Admins bypass via the `isAdmin()` branch.
      allow update: if (isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.get('tracks', []) == resource.data.get('tracks', [])
            && request.resource.data.get('permissions', {}) == resource.data.get('permissions', {})
            && request.resource.data.get('suRecognised', false) == resource.data.get('suRecognised', false)
            // Admin-set paid-member tag: pinned against self-edits exactly
            // like `tracks` (see the create rule for why it matters — it is
            // a badge in front of admissions reviewers). The [] default makes
            // the pin hold on the common absent-vs-absent case.
            && request.resource.data.get('paidMembershipYears', [])
              == resource.data.get('paidMembershipYears', [])
            // `email` is PROVEN-inbox state, not a profile field. Downstream it
            // is trusted as an address the user demonstrably controls:
            // /api/subscriptions/sync marks rows `confirmed` from it with no
            // click, the newsletter sender resolves recipients from it, and
            // /api/admin/application-emails/send mails it. Leaving it writable
            // let any self-registered account point it at a stranger and have
            // the server treat that stranger's inbox as opted in.
            // No legitimate client flow rewrites it: the profile form touches
            // only `profile.*`, and registration sets it once at create from
            // the Auth token. Pinning it costs nothing and closes three paths.
            && request.resource.data.get('email', '') == resource.data.get('email', '')
            // Consent is an AUDIT RECORD, so the subject must not be able to
            // write it. Both fields were absent from these rules entirely, and
            // with no keys().hasOnly() a member could bump `policyVersion` to
            // skip the re-consent gate AND fabricate the `policyAgreedAt` that
            // says they agreed — the half that matters under UK GDPR.
            // Re-consent is server-stamped (/api/account/reconsent, Admin SDK,
            // which bypasses these rules), so locking self-updates costs no
            // legitimate flow. The initial value is still written once at
            // registration, by the create rule above (signInWithGoogle.ts).
            // Note this sits INSIDE the self-update disjunct on purpose: the
            // isAdmin() branch above is unaffected.
            // The VERSION is the security property — claiming to have accepted
            // a policy you never saw is the forgery, and skipping the
            // re-consent gate is the escalation. It is pinned outright.
            && request.resource.data.get('policyVersion', '')
              == resource.data.get('policyVersion', '')
            // The timestamp may only stay put or be re-stamped to the server's
            // own clock, never back-dated to a value of the caller's choosing.
            // `request.time` is what a client `serverTimestamp()` resolves to,
            // which is what makes the registration RETRY work: completeRegistration
            // writes an unmerged setDoc, so a second attempt re-sends
            // policyAgreedAt for the SAME version. Requiring strict equality
            // here denied that retry outright — an over-tightening that would
            // have stranded anyone whose first attempt failed.
            && (
              request.resource.data.get('policyAgreedAt', null)
                == resource.data.get('policyAgreedAt', null)
              || request.resource.data.get('policyAgreedAt', null) == request.time
            )
            && (
              request.resource.data.get(['profile', 'universityEmail'], '')
                == resource.data.get(['profile', 'universityEmail'], '')
              || resource.data.get(['profile', 'universityEmailLockUntil'], request.time)
                <= request.time
            )
            // `uniEmailVerifiedAt` is server-authoritative (see the create rule)
            // and is BOUND to the address it attests to. A self-update may only
            // CLEAR it (the profile form does this on any uni-email change) or
            // leave it untouched WHILE the uni email is also unchanged. It may
            // never be introduced, changed, OR kept across an email change —
            // keeping a stale stamp while repointing `universityEmail` to a
            // victim's address would forge ownership of that address (the admin
            // "verified" badge + the findVerifiedUniEmailOwner squat). The server
            // (Admin SDK, which bypasses these rules) is the only writer of a
            // truthy stamp, always in lockstep with the verified address.
            && (
              !('uniEmailVerifiedAt' in request.resource.data.get('profile', {}))
              || (
                request.resource.data.get(['profile', 'uniEmailVerifiedAt'], null)
                  == resource.data.get(['profile', 'uniEmailVerifiedAt'], null)
                && request.resource.data.get(['profile', 'universityEmail'], '')
                  == resource.data.get(['profile', 'universityEmail'], '')
              )
            )))
        && smallEnough();

      allow delete: if isAdmin();
    }

    // === collaborators ===
    // External collaborator applications (people NOT at the University of
    // Nottingham). A SEPARATE collection from `users` so the member governance /
    // trust model is untouched. Doc id is "<name-slug>__<uid>"; the read gate
    // keys off the stored `uid` field, NOT the doc-id path param. All writes go
    // through server routes (Admin SDK) — clients never write — so this is
    // locked like subscriptions / eventRsvps; the create-route is the validation
    // + rate-limit boundary. Admins manage; a collaborator reads only their own
    // application (powers the limited collaborator area).
    match /collaborators/{docId} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.uid);
      allow write: if false;
    }

    // === projects ===
    match /projects/{projectId} {
      allow read:   if hasRole(['member', 'committee', 'admin']);
      allow write:  if isAdmin();
    }

    // === tasks ===
    //
    // Visibility model:
    // - 'committee' visibility: every SU-recognised committee member + admin
    //   sees the task on the board. Non-SU committee see it only if they are
    //   on it (completer/reviewer).
    // - 'assignees-only': only the listed completers/reviewers + admins see it.
    //   Admins-only toggle (committee cannot create OR flip to assignees-only).
    // - Members (and non-SU committee) can create tasks ONLY for themselves
    //   with source='personal' and visibility='assignees-only' (powers the
    //   "quick add" on My Work).
    //
    // Sequential subtask gating (blockedBy) is enforced client-side, not here —
    // evaluating it would mean scanning two arrays on every write. Inside a
    // committee-visibility task, everyone in the thread is trusted.
    match /tasks/{taskId} {
      function taskData()    { return resource.data; }
      function isCompleter() {
        return isSignedIn() && request.auth.uid in taskData().completerUids;
      }
      function isReviewer() {
        return isSignedIn() && request.auth.uid in taskData().reviewerUids;
      }
      function isTaskCreator() {
        return isSignedIn() && request.auth.uid == taskData().creatorUid;
      }
      // Committee powers on tasks (seeing every committee-visibility task and
      // creating/managing them) are limited to SU-recognised committee plus
      // admins. Non-SU committee collaborate only on tasks they are explicitly
      // added to, via the isCompleter()/isReviewer() branches.
      function isCommittee() { return isAdmin() || isSuCommittee(); }
      function visibleToMe() {
        return isAdmin()
          || (isCommittee() && taskData().visibility == 'committee')
          || isCompleter()
          || isReviewer();
      }

      allow read: if visibleToMe();

      allow create: if isSignedIn()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.subtasks.size() <= 50
        && request.resource.data.completerUids.size() <= 10
        && request.resource.data.reviewerUids.size() <= 5
        && request.resource.data.get('blocks', []).size() <= 10
        // `sourceRef` is the pointer that binds a MIRROR to its (cohort,
        // week), and no client creates a mirror: courseTasks.ts writes them
        // on the Admin SDK, and the one client create path (taskMutations
        // createTask, both the committee board and the My Work quick-add)
        // writes `sourceRef: null`. So nothing legitimate sets it here, and
        // leaving it open let ANY signed-in user mint a task stamped
        // `sourceRef.cohortId = <someone's run>` — which is the id a run
        // destroy sweeps on. Pinned null on both lanes, committee included.
        && request.resource.data.get('sourceRef', null) == null
        && (
          isCommittee()
          || (
            request.resource.data.source == 'personal'
            && request.resource.data.visibility == 'assignees-only'
            && request.resource.data.completerUids.hasOnly([request.auth.uid])
            && request.resource.data.completerUids.size() == 1
            && request.resource.data.reviewerUids.size() == 0
          )
        );

      // Admin = full control (incl. flipping visibility).
      // SU committee = full control on committee-visibility tasks but CANNOT
      // flip visibility to 'assignees-only' (admin-only).
      // Completers + reviewers = narrow field-level writes (status/subtasks/
      // counters/blocks/blockConsents). Including reviewers here lets a
      // reviewer tick their review subtask even if they're not on the
      // completer list. `blocks` + `blockConsents` are in the narrow band
      // because completers drive the lock-in ritual (and that ritual may
      // atomically flip `block.sealState` to 'sealed' on the Nth consent).
      // Fine-grained "only-own-uid" consent-edit enforcement is client-side
      // — arrays-inside-maps diffing is too costly in rules.
      allow update: if
        isAdmin()
        || (
          isCommittee()
          && taskData().visibility == 'committee'
          && request.resource.data.visibility == 'committee'
          // `source` is set once at create and never legitimately rewritten.
          // Pinning it here is load-bearing: `source` gates BOTH the mirror
          // delete branch below and the `archived` entry in the completer
          // narrow band, so a committee member able to relabel a task
          // 'fellowship-reminder' could hand any completer on it a
          // recursiveDelete of that task's whole comment and activity history.
          && request.resource.data.get('source', '') == taskData().get('source', '')
          // `sourceRef` rides the same clause, and for a sharper reason. A
          // run DESTROY sweeps `tasks` by `sourceRef.cohortId` and
          // recursiveDeletes what it finds — comments, activity log,
          // attachments and their Storage blobs. Left writable on this
          // branch, an SU-committee member could stamp a doomed run's id onto
          // any committee task and have the next admin destroy erase it for
          // them, with the audit row recording it as one of the run's own
          // mirrors. (The engine also filters that sweep on `source ==
          // 'fellowship-reminder'`, which is the half that protects rows
          // written before this pin; this is the half that stops the field
          // being aimed in the first place.)
          && request.resource.data.get('sourceRef', null) == taskData().get('sourceRef', null)
          && request.resource.data.subtasks.size() <= 50
          && request.resource.data.completerUids.size() <= 10
          && request.resource.data.reviewerUids.size() <= 5
          && request.resource.data.get('blocks', []).size() <= 10
        )
        // `archived` joined the narrow band for the course-week mirrors, and it
        // is SCOPED to them: an enrolled member is sole completer on their
        // mirrored task and must be able to tidy it off the board without
        // asking an admin. Ungated it was a real widening — the band also
        // covers reviewers, and a reviewer is not necessarily a completer, so
        // any ONE person on a committee task could archive it while the My Work
        // and board queries hide archived tasks by default. That is a
        // unilateral "delete" of shared work in everything but name.
        //
        // Everyone with a legitimate reason to archive still has a branch:
        // admins above, an SU-committee creator via the committee branch, a
        // personal task's creator below (the task UI only offers Archive to
        // admin-or-creator anyway). The gate reads the STORED source — never
        // `request.resource.data` — so relabelling a task on the way in cannot
        // unlock it, and the affectedKeys test is evaluated FIRST so an
        // ordinary status/subtask write never depends on `source` at all.
        //
        // `sourceRef` stays OUTSIDE this list on purpose — it is the pointer
        // binding a mirror to its (cohort, week), and letting a completer
        // rewrite it would re-aim the mirror at a different cohort's week and
        // confuse the idempotent re-sync (courseTasks.ts) into duplicating
        // tasks.
        || (
          (isCompleter() || isReviewer())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'subtasks', 'subtaskStats', 'updatedAt',
            'completedAt', 'attachmentCount', 'commentCount',
            'blocks', 'blockConsents', 'archived'
          ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['archived'])
            || taskData().get('source', '') == 'fellowship-reminder'
          )
          && request.resource.data.subtasks.size() <= 50
          && request.resource.data.get('blocks', []).size() <= 10
        )
        // Creator of a personal task can edit it freely.
        // `reviewerUids` is pinned empty for the same reason the CREATE rule
        // requires size() == 0: a personal task is a private to-do for one
        // person. Without this the create-time check was trivially sidestepped
        // — create clean, then UPDATE reviewerUids to a list of strangers —
        // and naming someone as a reviewer both puts the task on their board
        // (isReviewer() satisfies visibleToMe()) and makes them a recipient of
        // the notify / send-for-review routes. That turned a private to-do
        // into a way to push attacker-chosen text at arbitrary members.
        || (
          taskData().source == 'personal'
          && isTaskCreator()
          && request.resource.data.visibility == 'assignees-only'
          && request.resource.data.source == 'personal'
          && request.resource.data.completerUids.hasOnly([request.auth.uid])
          && request.resource.data.reviewerUids.size() == 0
          // "Freely" stops short of the destroy pointer, same as the committee
          // branch above: a personal task is created with `sourceRef: null`,
          // nothing in the UI edits it, and a member who could set it would be
          // volunteering their own task into someone else's cascade.
          && request.resource.data.get('sourceRef', null) == taskData().get('sourceRef', null)
        );

      allow delete: if isAdmin()
        || (isCommittee() && taskData().visibility == 'committee' && isTaskCreator())
        || (taskData().source == 'personal' && isTaskCreator())
        // A mirrored course-week task ("fellowship-reminder") is dismissible
        // by the member it mirrors to. Keyed off isCompleter() rather than
        // isTaskCreator() so it survives however the mirror was materialised
        // (the sync route makes the member both, but an admin-triggered
        // backfill might not). Dismissal is safe BECAUSE the mirror is a
        // one-way projection at a deterministic id: deleting it loses no
        // course progress, and a later sync simply .create()s it again.
        || (taskData().source == 'fellowship-reminder' && isCompleter());

      // --- comments ---
      match /comments/{commentId} {
        function parent() {
          return get(/databases/$(database)/documents/tasks/$(taskId)).data;
        }
        function canAccessParent() {
          return isAdmin()
            || (isSuCommittee() && parent().visibility == 'committee')
            || request.auth.uid in parent().completerUids
            || request.auth.uid in parent().reviewerUids;
        }
        allow read: if canAccessParent();
        allow create: if canAccessParent()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.bodyMarkdown.size() <= 2000
          && request.resource.data.get('mentions', []).size() <= 20;
        // Editing your own comment ALSO requires still being able to reach the
        // task. Checking authorship alone let someone rotated off a task keep
        // permanent rewrite rights inside a thread they can no longer read —
        // silently altering the record for everyone still on it. Same oversight
        // class as the activity-log create rule.
        // `mentions` is capped because /api/tasks/[id]/notify emails every uid
        // in this array; an unbounded list is an unbounded send.
        allow update: if canAccessParent()
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'bodyMarkdown', 'editedAt', 'deleted', 'mentions'
          ])
          && request.resource.data.bodyMarkdown.size() <= 2000
          && request.resource.data.get('mentions', []).size() <= 20;
        allow delete: if isAdmin();
      }

      // --- activity log (append-only; no client updates/deletes) ---
      match /activity/{entryId} {
        function parent() {
          return get(/databases/$(database)/documents/tasks/$(taskId)).data;
        }
        function canAccessParent() {
          return isAdmin()
            || (isSuCommittee() && parent().visibility == 'committee')
            || request.auth.uid in parent().completerUids
            || request.auth.uid in parent().reviewerUids;
        }
        allow read: if canAccessParent();
        // `canAccessParent()` was defined here and used for read but NOT for
        // create, while the sibling comments/attachments blocks gate create on
        // it — an oversight that let any signed-in account (a brand-new
        // `pending` one included) append arbitrary text to the activity log of
        // a task it cannot even read, or to a task id that does not exist.
        // Every legitimate client write batches this alongside an update to a
        // task the actor can already reach, and canAccessParent() admits
        // everyone the task update rule does, so this closes the hole without
        // narrowing a real flow.
        allow create: if canAccessParent()
          && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }

      // --- attachments metadata ---
      match /attachments/{attachmentId} {
        function parent() {
          return get(/databases/$(database)/documents/tasks/$(taskId)).data;
        }
        function canAccessParent() {
          return isAdmin()
            || (isSuCommittee() && parent().visibility == 'committee')
            || request.auth.uid in parent().completerUids
            || request.auth.uid in parent().reviewerUids;
        }
        allow read: if canAccessParent();
        // `storagePath` MUST be confined to this task's own folder. Three
        // server routes (tasks/[id]/delete, delete-block, delete-subtask) read
        // this field and pass it to bucket.file(path).delete() through the
        // Admin SDK, which bypasses storage.rules entirely — so an unconstrained
        // value here meant any signed-in account could point it at
        // `event-images/...` or another task's blobs, delete its own throwaway
        // task, and have the server destroy arbitrary objects anywhere in the
        // bucket. The routes now validate the prefix too; this is the other half.
        allow create: if canAccessParent()
          && request.resource.data.uploadedByUid == request.auth.uid
          // `[^/]+$` rather than `.*`: a trailing `.*` still matched
          // `tasks/<id>/<att>/../../../newsletter-images/x.png`, which resolves
          // straight back out of the folder. One path segment, no traversal.
          && request.resource.data.get('storagePath', '')
               .matches('^tasks/' + taskId + '/' + attachmentId + '/[^/]+$');
        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.uploadedByUid == request.auth.uid);
        allow update: if false;
      }
    }

    // === taskTemplates ===
    // Person-agnostic task-structure templates (subtask titles, blockedBy graph,
    // role hints). Admins CRUD; committee + admin can read + instantiate into
    // new tasks. Templates never store user UIDs — the creator picks completers
    // and reviewers at task-creation time.
    match /taskTemplates/{templateId} {
      allow read: if hasRole(['committee', 'admin']);
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.subtasks.size() <= 50;
      allow delete: if isAdmin();
    }

    // === credentials (committee only, client-side encrypted) ===
    // THE FEATURE IS NOT BUILT (see CLAUDE.md > What's not built yet): there is
    // no feature code, only a placeholder page. Until it exists these rules
    // should grant nothing — a deployed grant for an unbuilt feature is pure
    // attack surface. Previously `allow read, write: if hasRole([...])` gave
    // EVERY committee account, including non-SU committee (whom the trust model
    // scopes to tasks they are named on), unvalidated and uncapped read, write
    // and delete: free arbitrary storage and write amplification on a
    // no-billing project.
    // When the credentials feature lands, add a validated create/update rule
    // here alongside it, gated on isSuCommittee() rather than bare role.
    match /credentials/{entryId} {
      allow read, write: if false;
    }
    match /credentialsMeta/{id} {
      allow read:  if isAdmin() || isSuCommittee();
      allow write: if false;
    }

    // === bookings ===
    // No booking feature writes from the client yet. The old
    // `create: if isSignedIn()` was unvalidated: any signed-in user could
    // forge booking docs (arbitrary host/guest uids, no size cap, naming
    // someone else as host so it surfaced in their view). All client writes
    // are locked; when the booking feature lands its writes go through the
    // Admin SDK (which bypasses rules) and a validated create rule is added
    // here alongside it.
    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (isSignedIn() && (request.auth.uid == resource.data.hostUid
                          || request.auth.uid == resource.data.guestUid));
      allow create, update, delete: if false;
    }

    // === news (public read, admin write) ===
    match /news/{slug} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // === newsletterDrafts ===
    // Drafters (permissions.draftNewsletter) and approvers (permissions.approveNewsletter)
    // get access; admin is always in. Final send happens server-side via a
    // privileged API route — clients never set status == 'sent' directly.
    match /newsletterDrafts/{draftId} {
      function me() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function hasPerm(key) {
        return isSignedIn()
          && (me().role == 'admin' || me().get(['permissions', key], false) == true);
      }
      function canDraft()   { return hasPerm('draftNewsletter');   }
      function canApprove() { return hasPerm('approveNewsletter'); }

      allow read:   if canDraft() || canApprove();
      allow create: if canDraft()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'draft';
      // Per-document scoping, mirroring what PR #225 did for `events`. This
      // block had none: `draftNewsletter` is a GLOBAL permission a plain member
      // can hold, so any drafter could edit ANY draft, self-approve their own,
      // and — the sharp end — silently rewrite the subject and body of a draft
      // ALREADY at status 'approved'. The approver signs off on one newsletter
      // and the send route ships a different one to the whole list.
      function isOwnDraft() {
        return isSignedIn() && resource.data.get('authorUid', '') == request.auth.uid;
      }
      allow update: if isAdmin()
        || (
          (canApprove() || (canDraft() && isOwnDraft()))
          // 'sent' transitions only happen via admin SDK on the server.
          && request.resource.data.status != 'sent'
          && resource.data.get('status', 'draft') != 'sent'
          // An APPROVED draft is frozen to its author: re-opening it for edits
          // requires the approve permission, so content cannot change after
          // sign-off without a second pair of eyes.
          && (
            resource.data.get('status', 'draft') != 'approved'
            || canApprove()
          )
          && (
            // Content edits that leave the workflow state alone.
            request.resource.data.status == resource.data.status
            // Author self-service: park as draft, or send for review.
            || (isOwnDraft() && request.resource.data.status in ['draft', 'pending'])
            // Approving or rejecting is the two-person half of review.
            || canApprove()
          )
        );
      allow delete: if isAdmin()
        || (canDraft() && resource.data.authorUid == request.auth.uid);
    }

    // === events ===
    // Parallel to newsletterDrafts — orthogonal permissions.
    // Drafters can create/read/update; approvers can read/update; admins always in.
    // The whole committee can read every event: the events area is open to all
    // committee members, who plan and collaborate there even without the
    // draft/approve permissions. Published events are also readable by any
    // signed-in user (members see them on the authed events list). Public
    // visibility for unauthenticated readers is served via a server route
    // using the admin SDK. 'published' transitions only happen via the admin SDK.
    match /events/{eventId} {
      function me() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function hasPerm(key) {
        return isSignedIn()
          && (me().role == 'admin' || me().get(['permissions', key], false) == true);
      }
      function canDraft()   { return hasPerm('draftEvent');   }
      function canApprove() { return hasPerm('approveEvent'); }
      // A per-event collaborator: a committee member the author or an admin
      // explicitly added so they can edit this specific event.
      function isCollaborator() {
        return isSignedIn()
          && request.auth.uid in resource.data.get('collaboratorUids', []);
      }

      allow read: if canDraft() || canApprove()
        || hasRole(['committee', 'admin'])
        || (isSignedIn() && resource.data.status == 'published');
      allow create: if canDraft()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'draft';
      // Per-document scoping. `draftEvent` is a GLOBAL permission a plain
      // member can hold, so without an ownership test it granted write access
      // to EVERY event — including cancelling someone else's published one,
      // because only the INCOMING status was ever checked. A collaborator is
      // already per-event by construction (they are named on the doc).
      function isOwnEvent() {
        return isSignedIn() && resource.data.get('authorUid', '') == request.auth.uid;
      }
      // Fields nobody inside the branches below may rewrite from the client.
      // The per-document scoping added in PR #225 decided WHO may edit and in
      // WHICH states, but pinned nothing about WHAT — so a named collaborator
      // (who may be a plain member with no permissions at all, since
      // isCollaborator() only tests membership of collaboratorUids) could seize
      // `authorUid`, add accomplices to `collaboratorUids`, or rewrite the
      // rsvpCount* counters that drive capacity and waitlist decisions.
      // Ownership and attendance are the server's to change:
      // /api/events/[id]/collaborators manages the roster and the RSVP routes
      // own the counters, all Admin SDK.
      //
      // `visibility` is deliberately NOT pinned. The editor legitimately
      // patches it (eventMutations.ts:112) while drafting, and the outer rule
      // already refuses any client write once the STORED status is published
      // or cancelled — so a members-only event cannot be flipped public while
      // it is actually live. Pinning it would break a real flow to prevent
      // nothing.
      function pinnedFieldsUnchanged() {
        return request.resource.data.get('authorUid', '') == resource.data.get('authorUid', '')
          && request.resource.data.get('collaboratorUids', [])
               == resource.data.get('collaboratorUids', [])
          && request.resource.data.get('rsvpCountPending', 0)
               == resource.data.get('rsvpCountPending', 0)
          && request.resource.data.get('rsvpCountConfirmed', 0)
               == resource.data.get('rsvpCountConfirmed', 0)
          && request.resource.data.get('rsvpCountWaitlisted', 0)
               == resource.data.get('rsvpCountWaitlisted', 0);
      }
      allow update: if isAdmin()
        || (
          (canApprove() || isCollaborator() || (canDraft() && isOwnEvent()))
          && pinnedFieldsUnchanged()
          // An APPROVED event is frozen to its author for the same reason an
          // approved newsletter is: otherwise the approver reviews one event
          // and the publish route ships another. Re-opening it needs canApprove().
          && (
            resource.data.get('status', 'draft') != 'approved'
            || canApprove()
          )
          // Once an event is LIVE it is server territory: post-publish edits go
          // through /api/events/[id]/update (which diffs and sends the change
          // notices) and cancellation through .../cancel, both Admin SDK. The
          // STORED status is what matters here — testing only the incoming one
          // was the original bug, and checking it alone still let an author
          // quietly unpublish their own live event by reverting it to draft.
          && resource.data.get('status', 'draft') != 'published'
          && resource.data.get('status', 'draft') != 'cancelled'
          && request.resource.data.status != 'published'
          && (
            // Content edits that leave the workflow state alone.
            request.resource.data.status == resource.data.status
            // Author/collaborator self-service: park as draft, or send for review.
            || ((isOwnEvent() || isCollaborator())
                && request.resource.data.status in ['draft', 'pending'])
            // Every state that CONFERS or WITHDRAWS publication — approved,
            // rejected, cancelled — requires the approve permission. That is
            // the two-person half of review: holding `draftEvent` alone must
            // never move an event through it, not even your own.
            || canApprove()
          )
        );
      // Deletion goes through /api/events/[id]/delete (Admin SDK), which
      // cascades the event's RSVPs and images before removing the doc. Client
      // delete is withdrawn for the same reason `registrations` locks it: a
      // client can only ever delete the event document — `eventRsvps` denies
      // client writes outright — so a direct delete stranded every attendee's
      // name, email and free-text answers with no event left to justify them.
      // A forensic scan found exactly that on production (6 rows, 6 images).
      // The route re-implements the authorisation this rule used to express.
      allow delete: if false;
    }

    // === applicationEmailTemplates ===
    // Admin-edited boilerplates for lifecycle emails (submitted/approved/rejected).
    // Server send routes use the admin SDK and bypass these rules; the rules
    // below are for the admin editor client.
    match /applicationEmailTemplates/{templateId} {
      allow read:  if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.recipients in ['both', 'google', 'university']
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 200;
    }

    // === emailVerifications ===
    // One doc per outstanding magic-link uni-email verification. Created by
    // the server-side /api/verify-email/send route; mutated by the
    // /api/verify-email/confirm route (admin SDK in both cases). Clients are
    // allowed to READ the doc they initiated (so the register tab can
    // onSnapshot for `verifiedAt != null`), but cannot write — writes go
    // through the signed-token endpoints only.
    match /emailVerifications/{tokenId} {
      allow read: if isSignedIn()
        && request.auth.uid == resource.data.authUid;
      allow write: if false;
    }

    // === suppressedEmails ===
    // Populated by the SES→SNS bounce/complaint webhook via the admin SDK.
    // No client access — the send routes that consult this list also use the
    // admin SDK, so rules below stay fully locked.
    match /suppressedEmails/{docId} {
      allow read, write: if false;
    }

    // === emailSends ===
    // Append-only send log populated by sendEmail() on success and updated
    // by the SES→SNS webhook on bounce/complaint. Admin SDK only — the admin
    // deliverability dashboard reads it through a server route.
    match /emailSends/{docId} {
      allow read, write: if false;
    }

    // === registrations ===
    // One durable doc per account created via the email-only register route
    // (keyed by Auth uid). Tracks emailVerified / passwordSet → the admin orphan
    // tracker + suspicious-signup flagger. All writes are Admin SDK (the
    // register / verify / password-set routes); the admin tab reads it through a
    // server route. Rows hold email PII, so client access is fully locked — same
    // posture as emailSends / suppressedEmails.
    //
    // Deletion (self-service unfinished-account delete, admin delete, and the
    // collaborator/member deletes) ALSO runs server-side via the shared account
    // cascade (deleteAccountCascade, Admin SDK). Client deletes stay locked on
    // purpose: a client deleting just this row — or just its users doc — would
    // skip the Auth + cross-collection teardown and recreate the ghost-row bug.
    match /registrations/{uid} {
      allow read, write: if false;
    }

    // === signupMetrics ===
    // Bounded daily signup-outcome counters (one doc per UTC day) powering the
    // reCAPTCHA-fail-rate signal. Admin SDK increments per attempt; the admin
    // summary route reads them. Fully locked to clients.
    match /signupMetrics/{date} {
      allow read, write: if false;
    }

    // === subscriptions ===
    // Junction collection: each row is one (recipient, channel) pair. All
    // mutations go through server routes (admin SDK) — clients never write.
    // Reads: admins see everything; signed-in users see only their own rows
    // (audience == "user" && audienceId == auth.uid), powering the member
    // settings UI.
    match /subscriptions/{docId} {
      allow read: if isAdmin()
        || (isSignedIn()
            && resource.data.audience == 'user'
            && resource.data.audienceId == request.auth.uid);
      allow write: if false;
    }

    // === subscriptionEvents ===
    // Append-only audit log: one doc per subscription action. All writes
    // go through server routes (admin SDK), clients never write. Reads
    // are admin-only; the admin Subscriptions tab streams the collection
    // to show per-row history.
    match /subscriptionEvents/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // === impersonations ===
    // Audit log of admin "view as" sessions. One doc per (start, end) pair,
    // written entirely by the /api/admin/impersonate* routes via Admin SDK.
    // Clients never write here; admins can read the log for a future
    // impersonations review tab.
    match /impersonations/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ========================================================================
    // V3 W3 PR6: scheduler
    // ========================================================================
    // Two collections behind POST /api/scheduler/tick. Both are shut to EVERY
    // client, admins included, and both are read back through
    // GET /api/admin/scheduler on the Admin SDK.
    //
    // `schedulerMarkers` is the claim-before-send marker for every tick job:
    // a deterministic, construct-only doc id per unit of work, created BEFORE
    // the send and stamped `sentAt` after it. A client able to WRITE here
    // could pre-create a marker id and permanently suppress a send it does
    // not want (its own application-deadline reminder, a facilitator's
    // unmarked-register follow-up task) and nothing downstream would notice,
    // because "marker exists" is exactly how every job decides the work is
    // already done. Suppression by forgery is the threat this rule exists
    // for, and it is why these markers do NOT live in `courseNudges`
    // (different collection, different threat model). A client able to READ
    // here would learn which named applicants have unsubmitted drafts and
    // which groups have unmarked registers, since every id component is also
    // stored as a field.
    //
    // `schedulerRuns` is the tick receipt, `tick__{bucket}__d{depth}`. It is
    // the DEDUPE for duplicate external deliveries as well as the log, so a
    // client write is a way to make the next scheduled tick believe it has
    // already run: a forged receipt for the current 15-minute bucket makes
    // the real delivery return `deduped: true` and do nothing.
    //
    // NOTE ⚠ `config/scheduler` (the kill switch and per-job state) is NOT
    // covered here. The `config` collection has no match block at all today,
    // so it is default-deny and safe; PR5 adds an explicit
    // `match /config/{doc}` deny block so that lockdown is visible in this
    // file rather than inferred. That is a documentation change, not a
    // behaviour change, and nothing in this region depends on it landing.
    //
    // NOTE ⚠ no rules deploy is strictly owed for this region: with `allow
    // read, write: if false` both matches are identical to Firestore's
    // implicit deny. They are written out so the lockdown is stated rather
    // than assumed, and so a later PR cannot casually relax one by adding a
    // block that looks like it is filling a gap.
    match /schedulerMarkers/{markerId} {
      allow read, write: if false;
    }

    match /schedulerRuns/{runId} {
      allow read, write: if false;
    }
    // ===================== end V3 W3 PR6: scheduler ==========================

    // === eventRsvps ===
    // RSVPs are attendee PII - never public read. All writes go through the
    // server route `/api/events/[id]/rsvp` (admin SDK), so rules are a safety
    // net, not the main gate. Reads: SU-recognised committee and admins only -
    // the same trust boundary as member PII and the committee task board. A
    // non-SU event author can plan the event but cannot see who signed up.
    match /eventRsvps/{rsvpId} {
      allow read: if isAdmin() || isSuCommittee();
      // No direct client writes; the API route uses the admin SDK.
      allow create, update, delete: if false;
    }

    // === publicConfig ===
    // World-readable runtime config. Today that is ONLY the site-notice doc,
    // and the match is pinned to that single doc id ON PURPOSE: `allow read`
    // also grants `list`, so a {docId} wildcard would make every future doc
    // dropped into this collection world-readable AND enumerable. If the
    // collection ever grows, add another pinned block per doc.
    // Nothing sensitive may land here — audit fields (who flipped it) go in
    // `config/siteNoticeAudit`, which has no match block and stays
    // default-deny. All writes go through /api/admin/site-notice (Admin SDK).
    match /publicConfig/siteNotice {
      allow read: if true;
      allow write: if false;
    }

    // === maintenanceLog ===
    // Public history of maintenance notices powering the /status page — one
    // doc per banner-visible episode, written ONLY by /api/admin/site-notice
    // (Admin SDK). Unlike publicConfig this wildcard is world-readable AND
    // enumerable ON PURPOSE (owner decision 2026-08-01): the whole point is a
    // public log. Nothing sensitive may ever be written here — entries carry
    // only admin-authored notice copy, level, times and pause flags.
    match /maintenanceLog/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    // === adminLocks ===
    // Soft, FAIL-OPEN coordination locks for the admin console. Two shapes,
    // distinguished by doc id:
    //   page__<key>       one-admin-at-a-time presence lease on an admin page.
    //   useredit__<uid>   "this member's details are under maintenance" while an
    //                     admin edits them.
    // Only admins acquire / heartbeat / release a lock. A member may READ the
    // useredit lock that targets THEM (doc id useredit__<their uid>) to show the
    // maintenance notice, and post a message to it, but never create/modify a
    // lock. The id-pattern check (not resource.data) lets a member read their own
    // lock doc even when it does not exist yet (an absent doc has no resource).
    match /adminLocks/{lockId} {
      allow read: if isSignedIn()
        && (isAdmin() || lockId == ('useredit__' + request.auth.uid));
      allow create, update, delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isSignedIn()
          && (isAdmin() || lockId == ('useredit__' + request.auth.uid));
        // Author can only post as themselves, on a page lock (admins) or their
        // own user-edit lock. Cap size + fix the shape so a client can't store
        // oversized / arbitrary message docs.
        allow create: if isSignedIn()
          && request.resource.data.fromUid == request.auth.uid
          && (isAdmin() || lockId == ('useredit__' + request.auth.uid))
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          // `fromName` needs a cap too. hasOnly() fixes WHICH keys may appear,
          // not how big they are, so with only `text` bounded a member could
          // write ~1MB documents to their own lock, unbounded in number.
          && request.resource.data.get('fromName', '') is string
          && request.resource.data.get('fromName', '').size() <= 120
          && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'text', 'createdAt']);
        allow update, delete: if false;
      }
    }

    // ========================= COURSES =========================
    // The BlueDot-style programmes feature. Access model in brief:
    //  - Curriculum (courses / courseRuns / weeks): signed-in READ only. The
    //    public catalogue is served by Admin-SDK fetchers on server components
    //    — there is deliberately NO public read rule, because `allow read`
    //    also grants `list` and drafts must never be world-enumerable.
    //  - Authoring is client-direct for `draftCourse` / `approveCourse`
    //    permission holders (the autosave path), with the events-block
    //    pattern throughout: per-doc ownership, server-owned fields pinned,
    //    status transitions gated on the approve permission.
    //  - Everything member-state-shaped EXCEPT courseProgress (applications,
    //    enrolments, exercise responses, attendance, nudges) is routes-only:
    //    those docs carry PII, counters that must move transactionally, or
    //    validation rules can't express (an exercise response's type vs its
    //    definition). courseProgress is THE one client-direct member write.

    // === courses ===
    // Evergreen curriculum shells. Field caps mirror COURSE_FIELD_LIMITS in
    // src/lib/firestore/courses.ts — keep the two in sync.
    match /courses/{courseId} {
      // A per-course collaborator: named on the doc by the author/admin via
      // the collaborators route, so they can edit THIS course without holding
      // the global draft permission (events collaboratorUids pattern).
      function isCourseCollaborator() {
        return isSignedIn()
          && request.auth.uid in resource.data.get('collaboratorUids', []);
      }
      function isOwnCourse() {
        return isSignedIn()
          && resource.data.get('authorUid', '') == request.auth.uid;
      }
      // Ownership and the collaborator roster are the server's to change —
      // /api/courses collaborator/publish routes, Admin SDK. Without these
      // pins a collaborator (possibly a plain member with no permissions at
      // all) could seize authorUid or add accomplices to the roster; the
      // exact hole the events block closed after PR #225.
      function coursePinnedFieldsUnchanged() {
        return request.resource.data.get('authorUid', '')
            == resource.data.get('authorUid', '')
          && request.resource.data.get('collaboratorUids', [])
            == resource.data.get('collaboratorUids', [])
          // The destroy MARKER, pinned exactly as it is on courseRuns and for
          // the same reasons — with one extra edge that makes it sharper here.
          // The update branch below admits COLLABORATORS, who may be plain
          // members with no course permission at all. Left unpinned, such an
          // actor could set `destroying: true` + `destroyAuditId` on a course
          // and point it at an EXISTING courseDeletions row: the next real
          // cascade would then read the marker as a resume, skip its blockers,
          // and accumulate its counts and its completedAt onto an unrelated
          // audit record — falsifying the only surviving evidence of somebody
          // else's destroy. They could also wedge the course's own destroy,
          // since a marked course never re-checks the blockers that protect
          // its runs.
          && request.resource.data.get('destroying', false)
            == resource.data.get('destroying', false)
          && request.resource.data.get('destroyAuditId', '')
            == resource.data.get('destroyAuditId', '')
          // A course has no `archived` BOOLEAN today — it withdraws through
          // `status: 'archived'`, which the status clause below already gates
          // on approveCourse. The pin is here so that stays true: if a course
          // ever grows the run's soft-archive flag, it is born pinned rather
          // than born client-writable, which is the way round that gets
          // noticed.
          && request.resource.data.get('archived', false)
            == resource.data.get('archived', false);
      }

      allow read: if isSignedIn();

      allow create: if canDraftCourse()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.get('collaboratorUids', []).size() == 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.get('summaryBlocks', []).size() <= 40
        // Clean start, the courseRuns rule's twin: update only PINS the
        // marker, so a course could otherwise be BORN mid-destroy — pointing
        // at an audit row it does not own, and skipping the blocker check on
        // its first real destroy.
        && request.resource.data.get('destroying', false) == false
        && request.resource.data.get('destroyAuditId', '') == ''
        && request.resource.data.get('archived', false) == false;

      allow update: if isAdmin()
        || (
          (canApproveCourse() || isCourseCollaborator()
            || (canDraftCourse() && isOwnCourse()))
          && coursePinnedFieldsUnchanged()
          // Frozen to non-admins mid-destroy, same as runs: the course destroy
          // confirms by TITLE on every pass, so a retitle wedges the cascade.
          && resource.data.get('destroying', false) == false
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.get('summaryBlocks', []).size() <= 40
          // draft -> published is publication, published -> archived is
          // withdrawal: every status move is the two-person half of review
          // and needs the approve permission, never the draft one alone.
          && (
            request.resource.data.status == resource.data.status
            || canApproveCourse()
          )
        );

      // Deletion cascades runs/weeks/groups/progress — far too much blast
      // radius for a client write. The destroy routes (Admin SDK) own it:
      // /api/courses/[courseId]/destroy for the course, with every run
      // destroyed first through /api/courses/runs/[runId]/destroy, each
      // paginated, resumable and audited. Soft archive is the primary path.
      allow delete: if false;
    }

    // =====================================================================
    // === V3 W1 PR7: coursePages ==========================================
    // =====================================================================
    // The AUTHORED public page for a course, at `coursePages/{courseId}`.
    // The doc id IS the course id, so a course structurally cannot have two
    // pages and nothing has to query for uniqueness.
    //
    // ROUTES-ONLY, deliberately unlike the `courses` block immediately above,
    // which is client-direct for the autosave path. The reason is specific and
    // is not a general preference for routes:
    //
    //   `sanitizeBlocks` (src/lib/firestore/newsletterBlocks.ts) is a SHAPE
    //   filter (`raw.filter(isValidBlock)`), not an HTML sanitiser. A
    //   `richText` block renders through `dangerouslySetInnerHTML`, and for
    //   THIS collection that render happens on a LOGGED-OUT marketing page.
    //   The `courses` update branch above admits `isCourseCollaborator()`,
    //   which that block's own comment describes as "possibly a plain member
    //   with no permissions at all".
    //
    // Two write paths cannot enforce one sanitisation, so there is one:
    // `PUT /api/courses/[courseId]/page` (Admin SDK), which sanitises what it
    // stores, plus `normalizeCoursePage` sanitising again at read time. Making
    // this collection client-writable would delete both guarantees at once.
    //
    // Read is signed-in, matching `courses` and `courseRuns`: the public
    // pages are served by Admin-SDK fetchers on server components, and a
    // world-readable rule would also grant `list`, making an unpublished
    // course's draft pitch enumerable.
    //
    // The page holds no uid and no member text. It is destroyed with its
    // course (`courseDeletion.ts`) and is deliberately not part of the
    // per-account deletion sweep.
    match /coursePages/{courseId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    // === end V3 W1 PR7: coursePages ======================================

    // === courseRuns ===
    // One delivery of a course ("Autumn 2026"). Role arrays, counters and the
    // cohort channel are server-owned: admissions reviewers / facilitators /
    // track leads are assigned by routes, applicationCounts moves inside the
    // apply/decide transactions, and `channel` is what the cohort email send
    // resolves recipients from — a client-writable channel would let a
    // drafter aim a run's email at a different cohort's subscribers.
    match /courseRuns/{runId} {
      function isOwnRun() {
        return isSignedIn()
          && resource.data.get('authorUid', '') == request.auth.uid;
      }
      function isRunTrackLead() {
        return isSignedIn()
          && request.auth.uid in resource.data.get('trackLeadUids', []);
      }
      function runPinnedFieldsUnchanged() {
        return request.resource.data.get('courseId', '')
            == resource.data.get('courseId', '')
          && request.resource.data.get('authorUid', '')
            == resource.data.get('authorUid', '')
          && request.resource.data.get('admissionsReviewerUids', [])
            == resource.data.get('admissionsReviewerUids', [])
          && request.resource.data.get('runFacilitatorUids', [])
            == resource.data.get('runFacilitatorUids', [])
          && request.resource.data.get('trackLeadUids', [])
            == resource.data.get('trackLeadUids', [])
          && request.resource.data.get('applicationCounts', {})
            == resource.data.get('applicationCounts', {})
          && request.resource.data.get('groupCount', 0)
            == resource.data.get('groupCount', 0)
          && request.resource.data.get('channel', '')
            == resource.data.get('channel', '')
          // `archived` is the everyday soft path of the V2-1 deletion protocol
          // (mirroring courseGroups.archived, orthogonal to `status` — the run
          // status union has no archived member). An archived run drops out of
          // the admin default list, the public catalogue, the /me live sections
          // and the application windows, while member history keeps reading it.
          // That is a WITHDRAWAL, so it belongs to the same lane as a status
          // move, not to run content: PATCH /api/courses/runs/[runId]/archive
          // (Admin SDK, admin or approveCourse) is the only writer. Pinning it
          // here is what stops a drafter or a track lead — who legitimately edit
          // weekPlan and label all term — from unpublishing a live cohort with
          // one field, silently, from the client. Both sides default so a run
          // predating the field compares false to false and passes.
          //
          // NOTE the admin carve-out: like every other pin in this function, it
          // sits on the non-admin branch only, so an admin CAN still flip the
          // flag directly. That hands them nothing — admins already hold
          // unconditional update on runs, including `status: cancelled`, which
          // withdraws a run harder than archiving it. The approveCourse holder
          // is the interesting case and is NOT carved out: they may call the
          // archive route but may not write the field, so their archive always
          // goes through the route.
          && request.resource.data.get('archived', false)
            == resource.data.get('archived', false)
          // The destroy MARKER, stamped by beginDestroy() in the same
          // transaction that opens the courseDeletions audit row. It is the
          // resume cursor: `destroying` says a cascade is in flight and
          // `destroyAuditId` names the row it accumulates into. Both are
          // pinned for the same reason `archived` is, only harder —
          //   * clearing `destroying` makes the NEXT invocation look fresh, so
          //     it opens a SECOND audit row and the first is left dangling at
          //     completedAt: null, indistinguishable from a real interruption;
          //   * repointing `destroyAuditId` aims the accumulating counts (and
          //     the resumeCount increment) at somebody else's audit row, which
          //     is how you falsify the only surviving record of a destroy;
          //   * setting either one on a live run wedges the archive route,
          //     which refuses to touch a run that says it is being destroyed.
          // Nothing outside the cascade ever writes these, so pinning them
          // costs no legitimate flow.
          && request.resource.data.get('destroying', false)
            == resource.data.get('destroying', false)
          && request.resource.data.get('destroyAuditId', '')
            == resource.data.get('destroyAuditId', '')
          // TEMPLATE PROVENANCE (V2-2, v2 decision 3). `templateId` names the
          // frozen `courseTemplates` snapshot this run's weeks were applied
          // from and `templateLabel` is the point-in-time copy of what that
          // snapshot was called. Only
          // POST /api/courses/runs/[runId]/apply-template (Admin SDK) writes
          // them, and only alongside the weeks it just copied in.
          //
          // Pinned because the actors this branch admits — the drafter-owner
          // and the run's TRACK LEADS — are precisely the people who spend the
          // term editing that curriculum. Unpinned, one of them could rewrite
          // every week of a run by hand and then stamp it "Autumn 2026 final",
          // or strip the stamp off a run that really was built from a snapshot.
          // Either way the only surviving record of WHAT A COHORT WAS ACTUALLY
          // TAUGHT would be a field its editors could set to anything, which
          // is not provenance. The approveCourse holder is the interesting
          // case and is NOT carved out, exactly as with `archived`: they may
          // CALL apply-template, but they may not write the fields, so their
          // stamp always arrives with the copy that earned it.
          //
          // Both sides default to '' so a run predating the field compares
          // equal and passes. That is also why the route writes STRINGS and
          // never null — a stored null would compare unequal to the ''
          // default and wedge every later non-admin edit of the run.
          && request.resource.data.get('templateId', '')
            == resource.data.get('templateId', '')
          && request.resource.data.get('templateLabel', '')
            == resource.data.get('templateLabel', '')
          // ---- V3 W1 PR5: courses open mode -------------------------------
          //
          // `enrolMode` opens a WRITE DOOR rather than describing content: an
          // `open` run admits an enrolment with no application behind it, so
          // it belongs in this tier with the role arrays and the counters and
          // not in the drafter's content band. Its only writer is
          // PATCH /api/courses/runs/[runId]/enrol-mode (admin only).
          //
          // `streams` looks like authored content and is not. The enrol route
          // validates a member's requested stream against this list, and
          // `courseEnrolments.streamId` is `allow write: if false`, so a
          // client-direct edit here could invalidate rows in a collection the
          // client cannot repair. Same class as `applicationCounts`.
          //
          // `enrolledCount` is a counter moved only by the transactions that
          // write the enrolment rows it summarises, exactly like `groupCount`.
          //
          // `submissionExerciseRef` is pinned with a `{}` default on BOTH
          // sides and is stored ABSENT when unset, NEVER null: this file
          // already records at the templateId pin above that a stored null
          // compares unequal to a `.get()` default and wedges every later
          // non-admin edit of the run. `courses.ts` omits the key rather than
          // writing null so a doc round-tripped through the normaliser cannot
          // reintroduce one, and the emulator suite pins both halves.
          && request.resource.data.get('enrolMode', 'admissions')
            == resource.data.get('enrolMode', 'admissions')
          && request.resource.data.get('streams', [])
            == resource.data.get('streams', [])
          && request.resource.data.get('enrolledCount', 0)
            == resource.data.get('enrolledCount', 0)
          && request.resource.data.get('submissionExerciseRef', {})
            == resource.data.get('submissionExerciseRef', {});
      }

      // ---- V3 W1 PR5: courses open mode ---------------------------------
      // THE STATUS TRANSITION TABLE, mirroring src/lib/courses/runStatus.ts.
      //
      // Why the rules now carry a table the route already owns: the week-plan
      // freeze above is keyed on the status, and `canApproveCourse()` could
      // write ANY status value. So an approver could walk a live run back to
      // `draft`, reshape the frozen plan, and walk it forward again: three
      // writes, no route, and the freeze is defeated. A freeze keyed on a
      // field its subject can set to anything is not a freeze.
      //
      // Read as: from this status, these are the reachable ones.
      //   draft                -> applications-open | cancelled
      //   applications-open    -> applications-closed | running | cancelled
      //   applications-closed  -> running | cancelled
      //   running              -> completed | cancelled
      //   completed, cancelled -> nothing (terminal)
      // `draft` appears on nobody's list on purpose: nothing returns to draft.
      // `applications-open -> running` is the open-enrolment entry: a
      // pre-course keeps its sign-ups open into its first teaching weeks and
      // has no review stage to close.
      //
      // Staying put is always legal: an ordinary content save re-sends the
      // status it already had, and this must not refuse those.
      //
      // ADMINS RIDE THEIR OWN BRANCH, as with every other pin in this block.
      // That costs nothing here: an admin already holds unconditional update
      // on runs including `weekPlan` itself, so denying them the backwards
      // move would protect nothing they cannot do directly. The person this
      // table exists to bound is the approver.
      //
      // Both sides default to 'draft' so a run written before the status
      // union existed is treated as a draft rather than frozen out of reach.
      function runStatusMoveAllowed() {
        return request.resource.data.get('status', 'draft')
            == resource.data.get('status', 'draft')
          || request.resource.data.get('status', 'draft') in {
              'draft': ['applications-open', 'cancelled'],
              'applications-open': ['applications-closed', 'running', 'cancelled'],
              'applications-closed': ['running', 'cancelled'],
              'running': ['completed', 'cancelled'],
              'completed': [],
              'cancelled': []
            // `.get(key, [])` rather than `[key]`, so a run carrying a status
            // outside the union (a hand-edited doc, or one written before a
            // rename) is simply frozen for non-admins instead of erroring
            // every update on the branch.
            }.get(resource.data.get('status', 'draft'), []);
      }
      // THE WEEK PLAN LOCK. `weekPlan` is the run's calendar spine: the Nth
      // taught entry IS week N, and every member-facing surface addresses that
      // week as `weekDocId(weekNumber)` while the plan carries its own stable
      // `weekId`. While a run is in DRAFT those two spellings can be
      // reconciled freely, because no member data exists yet to repoint.
      // The moment a run leaves draft they are load-bearing: reordering or
      // removing a slot renumbers every entry after it, so a cohort's
      // `/learn/{run}/weeks/{n}` silently resolves a different document than
      // the one the admin arranged, and the registers, mirrored tasks and
      // exercise responses keyed on the old numbering strand.
      //
      // So the plan is editable in draft and PINNED afterwards. Adding and
      // removing slots mid-term is not forbidden outright, it is moved to the
      // admin branch below, where the person making the change is the person
      // accountable for the date shift it causes.
      //
      // BOTH sides of the status are checked. Reading only the pre-write one
      // let a single update set status to 'applications-open' AND reshape the
      // plan in the same write: the run was a draft when the rule looked, and
      // was not one by the time the write landed, so the plan the pin then
      // protects for the rest of the cohort's life is the reshaped one nothing
      // ever checked. The status route is the intended lane for a status move
      // and writes nothing else, so no honest client is caught by this.
      //
      // The unchanged-plan disjunct stands on its own, which is what still
      // lets an approver flip the status while re-sending the plan verbatim
      // (a section save that always includes the field).
      //
      // Both sides default to [] so a run predating the field compares equal
      // and passes, and the status defaults to 'draft' so a run written before
      // the status union existed is treated as still editable rather than
      // frozen out of reach.
      function weekPlanLockRespected() {
        return (
            resource.data.get('status', 'draft') == 'draft'
            && request.resource.data.get('status', 'draft') == 'draft'
          )
          || request.resource.data.get('weekPlan', [])
            == resource.data.get('weekPlan', []);
      }

      // Content caps shared by create and update. `startDate` must be a
      // civil "YYYY-MM-DD" — the week maths (weekPlan.ts) runs on civil
      // dates so DST can't shift week boundaries, and a malformed date here
      // would poison every derived week number for the whole cohort.
      function runContentOk() {
        return request.resource.data.startDate is string
          && request.resource.data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.get('label', '').size() <= 80
          && request.resource.data.get('academicYear', '').size() <= 10
          && request.resource.data.get('courseTitle', '').size() <= 120
          && request.resource.data.get('weekPlan', []).size() <= 60
          && request.resource.data.get('applicationForm', []).size() <= 30
          // ---- V3 W1 PR7: coursePages (the two courseRuns authoring fields
          // that PR ships alongside the page object). `startHereBlocks` mirrors
          // COURSE_FIELD_LIMITS.maxStartHereBlocks; the `cohort` clause caps
          // the map's KEY SET, which is this layer's whole vocabulary for
          // bounding a map, and also refuses a stored null (`.keys()` on null
          // raises, and a stored null would wedge every later edit against the
          // `.get(field, {})` default: the submissionExerciseRef lesson).
          && request.resource.data.get('startHereBlocks', []).size() <= 20
          && request.resource.data.get('cohort', {}).keys()
            .hasOnly(['term', 'year', 'number']);
      }

      allow read: if isSignedIn();

      // Server-owned state must start CLEAN: empty role arrays, zeroed
      // counters, and the channel pinned to the deterministic cohort:<runId>
      // (courseRunChannel() in courses.ts). Requiring emptiness at create
      // matters because update only PINS these fields — a create that seeded
      // admissionsReviewerUids would smuggle in reviewers no route assigned.
      allow create: if canDraftCourse()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.get('admissionsReviewerUids', []).size() == 0
        && request.resource.data.get('runFacilitatorUids', []).size() == 0
        && request.resource.data.get('trackLeadUids', []).size() == 0
        && request.resource.data.get('applicationCounts', {}).values().hasOnly([0])
        && request.resource.data.get('groupCount', 0) == 0
        && request.resource.data.get('channel', 'cohort:' + runId) == 'cohort:' + runId
        // Same reason the arrays must start empty: update only PINS `archived`,
        // so without this it is the one pinned field a client could seed dirty —
        // minting a run that is born withdrawn and that only the archive route
        // can ever bring back. A run is created to be run.
        && request.resource.data.get('archived', false) == false
        // Likewise the destroy marker: a run created already claiming to be
        // mid-destroy would skip the blocker check on its first real destroy
        // (beginDestroy treats a marker as a resume) and would point the
        // accumulating counts at whatever audit id was seeded with it.
        && request.resource.data.get('destroying', false) == false
        && request.resource.data.get('destroyAuditId', '') == ''
        // Template provenance must start CLEAN, the `archived` argument
        // applied to the pin above: update only PINS these, so without this a
        // run could be BORN claiming to have been built from a snapshot it
        // never touched — a lie that no later edit can dislodge, because the
        // pin then protects it. A run is created empty and gets its
        // provenance from apply-template or not at all.
        && request.resource.data.get('templateId', '') == ''
        && request.resource.data.get('templateLabel', '') == ''
        // ---- V3 W1 PR5: courses open mode ----------------------------------
        // The birth pins for the four fields added to
        // runPinnedFieldsUnchanged() above. Update only PINS them, so without
        // these a drafter could mint a run BORN in open enrolment, pre-seeded
        // with streams no route assigned, or claiming a cohort it does not
        // have, and the pin would then protect the lie for the run's whole
        // life. This is the admissionsReviewerUids lesson, stated verbatim at
        // the top of this create rule.
        //
        // `submissionExerciseRef` must be ABSENT, not null: `{} == {}` passes
        // for an absent key and a stored null fails it, which is precisely
        // the wedge the pin's comment describes. Refusing it at birth is what
        // stops a run being created into that state.
        && request.resource.data.get('enrolMode', 'admissions') == 'admissions'
        && request.resource.data.get('streams', []).size() == 0
        && request.resource.data.get('enrolledCount', 0) == 0
        && request.resource.data.get('submissionExerciseRef', {}) == {}
        && runContentOk();

      // Status moves (applications-open, running, cancelled, ...) change what
      // the world sees and what the apply route accepts — approve-gated, same
      // two-person rule as events. A track lead may adjust run content (the
      // label, the dates, the application form, and the week plan while the
      // run is still a draft) but is NOT an approver, and once the run is out
      // of draft the plan itself is pinned by weekPlanLockRespected().
      allow update: if isAdmin()
        || (
          (canApproveCourse() || isRunTrackLead()
            || (canDraftCourse() && isOwnRun()))
          && runPinnedFieldsUnchanged()
          && runContentOk()
          && weekPlanLockRespected()
          // A run mid-destroy is frozen to non-admins entirely: every destroy
          // pass re-checks the typed confirmation against the CURRENT label,
          // so a rename here would wedge a half-finished cascade — the same
          // insider class the marker pins close. Admins ride their own branch.
          && resource.data.get('destroying', false) == false
          && (
            request.resource.data.status == resource.data.status
            || canApproveCourse()
          )
          // V3 W1 PR5: and even an approver may only make a move the table
          // allows. See runStatusMoveAllowed().
          && runStatusMoveAllowed()
        );

      allow delete: if false;

      // --- weeks (curriculum content, the autosave path) ---
      match /weeks/{weekId} {
        function run() {
          return get(/databases/$(database)/documents/courseRuns/$(runId)).data;
        }
        // Who may author curriculum in THIS run: admin, any approver, the
        // run's drafter-owner, or one of its track leads. Resolved against
        // the PARENT run doc — weeks carry no role fields of their own, so
        // there is nothing on the week for a writer to tamper with first.
        function canEditRun() {
          return isAdmin()
            || canApproveCourse()
            || (canDraftCourse() && run().get('authorUid', '') == request.auth.uid)
            || (isSignedIn() && request.auth.uid in run().get('trackLeadUids', []));
        }

        allow read: if isSignedIn();

        // `weekId` is "w01".."w60" — zero-padded so doc order matches week
        // order and STABLE across clone-weeks (progress rows reference item
        // ids inside these docs, so ids surviving a copy-forward is what
        // keeps a re-run's progress references valid). The id-shape check
        // plus the weekNumber bounds keep a typo'd editor write from minting
        // an unaddressable week.
        allow create, update: if canEditRun()
          && weekId.matches('^w[0-9][0-9]$')
          && request.resource.data.weekNumber is int
          && request.resource.data.weekNumber >= 1
          && request.resource.data.weekNumber <= 60
          && request.resource.data.get('title', '').size() <= 120
          && request.resource.data.get('summary', '').size() <= 1000
          && request.resource.data.get('guideBlocks', []).size() <= 40
          && request.resource.data.get('materials', []).size() <= 30
          && request.resource.data.get('exercises', []).size() <= 15
          && request.resource.data.get('checklist', []).size() <= 15;

        // Destroying authored content outranks editing it: a drafter or
        // track lead can blank a week's fields but not remove the doc.
        allow delete: if isAdmin() || canApproveCourse();
      }
    }

    // === courseGroups ===
    // The small facilitated groups inside a run. Groups carry the MEETING
    // LINK and weekly slot, so read access is the sharp edge: an enumerable
    // meet link is an open door for anyone signed-in to gatecrash a cohort
    // call. Reads are restricted to the authoring tier; members get their own
    // group's session card via a server route, facilitators via theirs.
    match /courseGroups/{groupId} {
      function isGroupFacilitator() {
        return isSignedIn()
          && request.auth.uid in resource.data.get('facilitatorUids', []);
      }
      // Track leads are named on the PARENT run, one get away.
      function isParentRunTrackLead() {
        return isSignedIn()
          && request.auth.uid in
            get(/databases/$(database)/documents/courseRuns/$(resource.data.get('runId', '')))
              .data.get('trackLeadUids', []);
      }
      // `facilitatorUids` is assigned by /api/courses/groups/[id]/facilitators
      // (which also upserts the facilitator enrolment); `memberCount` moves
      // only inside the allocation transaction so it can never drift from the
      // enrolment docs it summarises. runId/courseId are the group's identity.
      //
      // `paceStartDate`/`paceWeekPlan` (v2 decision 4, the group's calendar
      // copy-on-write) are server-owned like `memberCount`: only the pace
      // route writes them, because a plan edit must clear the strand gate (a
      // taught week with attendance marks cannot vanish from the plan) and a
      // rule cannot count registers. Pinned with a NULL default — the route
      // stores a REAL null when the group tracks the run, so absent (legacy
      // doc) and cleared compare equal and this pin can never wedge a
      // legitimate session edit (the templateId '' lesson, inverted).
      function groupPinnedFieldsUnchanged() {
        return request.resource.data.get('runId', '')
            == resource.data.get('runId', '')
          && request.resource.data.get('courseId', '')
            == resource.data.get('courseId', '')
          && request.resource.data.get('facilitatorUids', [])
            == resource.data.get('facilitatorUids', [])
          && request.resource.data.get('memberCount', 0)
            == resource.data.get('memberCount', 0)
          && request.resource.data.get('paceStartDate', null)
            == resource.data.get('paceStartDate', null)
          && request.resource.data.get('paceWeekPlan', null)
            == resource.data.get('paceWeekPlan', null)
          // ---- V3 W1 PR5: courses open mode -------------------------------
          //
          // `streamId` is the same correction as `courseRuns.streams`, one
          // level down: the enrol route decides who may join THIS group by
          // comparing their stream against this field, and
          // `courseEnrolments.streamId` is `allow write: if false`. A
          // facilitator retagging their own group client-direct would strand
          // rows in a collection no client can repair. Null default, like the
          // pace fields, so absent (every legacy group) and cleared compare
          // equal and this pin can never wedge a legitimate session edit.
          //
          // `facilitatorAppointments` records WHO put each uid in
          // `facilitatorUids`, and when. `facilitatorUids` itself has been
          // routes-only since it existed; a provenance map the same people
          // could rewrite would be worth less than no map at all.
          && request.resource.data.get('streamId', null)
            == resource.data.get('streamId', null)
          && request.resource.data.get('facilitatorAppointments', {})
            == resource.data.get('facilitatorAppointments', {});
      }
      // The per-week virtual/in-person mode ("v2 decision 7") is server-owned
      // too — the session route is the writer, so the room-notice prefill and
      // its audit ride along with every flip. It is stored as its own flat
      // map `sessionModes: { w03: "virtual" }` PRECISELY so this pin can be
      // one comparison: the first cut nested `mode` inside each
      // sessionOverrides value, and pinning a nested field across an
      // arbitrary-keyed map forced a 60-key enumeration that blew the rules
      // engine's 1000-expression evaluation budget and denied every
      // legitimate group write. A `mode` a client smuggles INTO a
      // sessionOverrides value instead is dead data: `normalizeCourseGroup`
      // reads modes exclusively from `sessionModes`.
      function groupSessionModesUnchanged() {
        return request.resource.data.get('sessionModes', {})
          == resource.data.get('sessionModes', {});
      }
      // Caps mirror GROUP_FIELD_LIMITS (courseGroups.ts) — the session fields
      // are client-editable by facilitators, so these ARE the boundary.
      // `meetingUrl` is null when the group meets in person, hence the
      // null-or-capped-string branch rather than a bare size() call (which
      // would error on null and deny every legitimate in-person write).
      function groupContentOk() {
        return request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.get(['session', 'location'], '').size() <= 200
          && (
            request.resource.data.get(['session', 'meetingUrl'], null) == null
            || (request.resource.data.session.meetingUrl is string
                && request.resource.data.session.meetingUrl.size() <= 300)
          )
          && request.resource.data.get(['session', 'notes'], '').size() <= 500
          && request.resource.data.get('sessionOverrides', {}).size() <= 20
          // V3 W1 PR5: see groupCapacityOk().
          && groupCapacityOk();
      }

      // ---- V3 W1 PR5: courses open mode -----------------------------------
      // CAPACITY, and why 40 is not a taste decision.
      //
      // `attendance/route.ts` throws RegisterFullError on the MERGED records
      // map for the WHOLE POST once a register passes ATTENDANCE_LIMITS
      // .maxRecords (40) keys. So an uncapped "everyone gets a place" group
      // does not merely leave its 41st member unmarked: it makes a bulk
      // "rest present" fail for everybody in the room and zeroes the
      // completion signal the pre-course bar is computed from.
      //
      // Two halves:
      //  - a capacity, when set, is a whole number in [1, 40] for EVERY run.
      //    An admissions group has the same register ceiling.
      //  - a capacity is REQUIRED on a group belonging to an open-mode run,
      //    which is the only cross-document part and the only reason a get()
      //    appears here. It is a WRITE rule, so this is not the
      //    get()-in-a-read-rule trap: `allow read` also grants `list` and
      //    would bill this per candidate document, whereas a write touches
      //    exactly one.
      //
      // The get() is deliberately the SECOND operand of the `||`, so it is
      // only evaluated when the capacity is missing. Every honest write on an
      // open-mode run carries one, so in practice the parent read never
      // happens. `runId` is read from request.resource.data, which is the
      // merged document on an update and is pinned unchanged by
      // groupPinnedFieldsUnchanged() anyway, so it names the same run either
      // way. `courseGroups.groupCapacityError()` carries the same rule for
      // the routes and the editor, with the sentence a human reads.
      function parentRunEnrolMode() {
        return get(/databases/$(database)/documents/courseRuns/$(request.resource.data.get('runId', '')))
          .data.get('enrolMode', 'admissions');
      }
      function groupCapacityOk() {
        return (
            request.resource.data.get('capacity', null) == null
            || (
              request.resource.data.capacity is int
              && request.resource.data.capacity >= 1
              // THE LITERAL 40 IS TWO CONSTANTS AT ONCE, and rules cannot
              // import either: `ATTENDANCE_LIMITS.maxRecords` (the register
              // ceiling the marking route enforces) and
              // `courseGroups.MAX_OPEN_MODE_CAPACITY` (the group cap, defined
              // equal to it on purpose). `tests/course-streams.test.mjs` §6.2
              // asserts those two ARE the same number, so raising one and not
              // this line fails a suite rather than a Tuesday evening.
              && request.resource.data.capacity <= 40
            )
          )
          && (
            request.resource.data.get('capacity', null) != null
            || parentRunEnrolMode() != 'open'
          );
      }

      allow read: if isAdmin() || canDraftCourse() || canApproveCourse();

      // Groups exist once a run is being staffed — approver territory. The
      // roster starts empty and the counter at zero for the same reason the
      // run's arrays must: update only pins them — and the server-owned pace
      // fields and session modes must start unset too, or a group could be
      // BORN carrying a calendar or a mode flip its pinned writers never
      // issued (the templateId birth-pin precedent on courseRuns).
      allow create: if (isAdmin() || canApproveCourse())
        && request.resource.data.runId is string
        && request.resource.data.runId.size() > 0
        && request.resource.data.get('facilitatorUids', []).size() == 0
        && request.resource.data.get('memberCount', 0) == 0
        && request.resource.data.get('paceStartDate', null) == null
        && request.resource.data.get('paceWeekPlan', null) == null
        && request.resource.data.get('sessionModes', {}).size() == 0
        // V3 W1 PR5: the birth pins for the two fields added to
        // groupPinnedFieldsUnchanged(). Update only PINS them, so without
        // these a group could be BORN tagged to a stream the enrol route
        // would then honour, or carrying appointment records naming
        // facilitators nobody appointed, and the pin would protect both for
        // the life of the group. Same argument as the pace fields above.
        && request.resource.data.get('streamId', null) == null
        && request.resource.data.get('facilitatorAppointments', {}).size() == 0
        && groupContentOk();

      // A named facilitator edits their own group's session (move the slot,
      // change the room, drop the term's overrides) — per-doc by construction,
      // same trust shape as an event collaborator. The `sessionModes` map
      // rides along UNCHANGED (see groupSessionModesUnchanged): flipping a
      // week virtual/in-person without the route lane's notice-and-audit
      // step is exactly what the pin exists to stop.
      allow update: if isAdmin()
        || (
          (canApproveCourse() || isParentRunTrackLead() || isGroupFacilitator())
          && groupPinnedFieldsUnchanged()
          && groupSessionModesUnchanged()
          && groupContentOk()
        );

      // Deleting a group must re-pool its members (allocation transaction) —
      // routes only.
      allow delete: if false;

      // --- weeks (the group's copy-on-write forks; v2 decision 4) ---
      // `courseGroups/{groupId}/weeks/{wNN}` exists the moment a facilitator
      // forks a week; its existence IS the resolution signal groupResolve.ts
      // reads. Signed-in read matches the run weeks rule above — a fork
      // carries curriculum, not the meet link, so the group doc's restricted
      // read does not extend down here. ALL writes are server-routed (the
      // fork POST and the week PATCH): the facilitator trust boundary
      // (text-safe fields yes, guideBlocks no) and the delete-warning counts
      // are cross-document checks a rule cannot express, so the simplest safe
      // boundary is no client pen at all — the courseAttendance stance.
      match /weeks/{weekId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // === courseApplications ===
    // One application per (run, uid), deterministic doc id. Rows carry email
    // PII and the paid-membership snapshot; the apply/decide routes own every
    // write (window/cap checks, counter transactions, lifecycle emails).
    // Reviewers read applications through the reviewer route, which strips
    // email — so client read here is OWN ROW ONLY, keyed off the stored uid
    // field (never parsed out of the doc id), plus admin.
    match /courseApplications/{docId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // === courseEnrolments ===
    // The no-double-placement invariant lives in this collection's doc id
    // (one per (run, uid)) and its single scalar groupId — which is exactly
    // why clients can never write: a client-side "move groups" would bypass
    // the allocation transaction that keeps memberCount honest. Own-row read
    // powers the /learn hub's "your runs" view.
    match /courseEnrolments/{docId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // === courseProgress ===
    // THE one client-direct member write in the courses feature: the
    // check-off hot path (complete a material, rate it, leave a comment)
    // commits instantly from the client, because the rules below can express
    // the entire invariant. Everything hangs off the deterministic doc id —
    // runId + '__' + auth.uid + '__' + itemId — which makes own-row-only
    // writes STRUCTURAL: there is no way to address anyone else's row.
    match /courseProgress/{progressId} {
      // NEVER use this in a READ rule. `allow read` also covers `list`, and
      // a list query evaluates its rule per candidate doc — so these lookups
      // would bill one document access PER ROW against the ~20-access rules
      // budget and any query over ~20 rows would be REJECTED WHOLESALE, an
      // outage that only appears once a member has enough progress rows.
      // Write-side only, where each request touches exactly one doc. The
      // courses rules test suite pins this with a 25-doc list regression.
      function isEnrolledActive(runId) {
        return exists(/databases/$(database)/documents/courseEnrolments/$(runId + '__' + request.auth.uid))
          && get(/databases/$(database)/documents/courseEnrolments/$(runId + '__' + request.auth.uid))
               .data.status == 'active';
      }
      // The full shape contract, shared by create and update:
      //  - doc id binds (runId, CALLER's uid, itemId) — the structural bit
      //  - only enrolled-and-active members write (withdrawn/removed lose
      //    the pen instantly, whatever the UI still shows)
      //  - keys are a closed set; optional fields are ABSENT, never null
      //    (buildProgressWrite in courseProgress.ts omits empties, so a null
      //    reaching here is a bug surfacing, not a flow to accommodate)
      //  - `hasPublicComment` is pinned to the actual comment: it is the
      //    queryable mirror the cohort comments lane filters on (Firestore
      //    can't query field-existence), and a row allowed to lie about it
      //    would leak or hide a comment from everyone on the run.
      function progressShapeOk() {
        return isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && progressId == request.resource.data.runId + '__' + request.auth.uid + '__' + request.resource.data.itemId
          && request.resource.data.runId is string
          && request.resource.data.runId.size() > 0
          && request.resource.data.itemId is string
          && request.resource.data.itemId.size() > 0
          && isEnrolledActive(request.resource.data.runId)
          && request.resource.data.keys().hasOnly([
            'runId', 'uid', 'weekNumber', 'itemKind', 'itemId', 'completed',
            'completedAt', 'rating', 'publicComment', 'hasPublicComment',
            'privateNote', 'moderatedByUid', 'moderatedAt', 'updatedAt'
          ])
          && request.resource.data.itemKind in ['material', 'checklist']
          && request.resource.data.weekNumber is int
          && request.resource.data.weekNumber >= 1
          && request.resource.data.weekNumber <= 60
          && request.resource.data.completed is bool
          && request.resource.data.hasPublicComment is bool
          && (
            !('completedAt' in request.resource.data)
            || request.resource.data.completedAt is timestamp
          )
          && (
            !('rating' in request.resource.data)
            || (request.resource.data.rating is int
                && request.resource.data.rating >= 1
                && request.resource.data.rating <= 5)
          )
          && (
            !('publicComment' in request.resource.data)
            || (request.resource.data.publicComment is string
                && request.resource.data.publicComment.size() <= 1000)
          )
          && (
            !('privateNote' in request.resource.data)
            || (request.resource.data.privateNote is string
                && request.resource.data.privateNote.size() <= 2000)
          )
          && request.resource.data.hasPublicComment == (
            'publicComment' in request.resource.data
            && request.resource.data.get('publicComment', '').size() > 0
          );
      }

      // Own-row only, and LIST QUERIES MUST CONSTRAIN uid == self or they
      // are denied outright. Admins moderate through the server routes
      // (Admin SDK), so no admin read branch is needed here — keeping the
      // rule get()-free is what makes big own-progress lists cheap.
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Moderation fields are the server's: their absence at create plus the
      // verbatim carry-through on update means a member can never fabricate,
      // clear, or launder a moderation stamp by re-saving the row.
      allow create: if progressShapeOk()
        && !('moderatedByUid' in request.resource.data)
        && !('moderatedAt' in request.resource.data);

      // The id pins runId/uid/itemId already (a doc id can't change), but
      // the field pins are stated anyway so a future id-scheme change can't
      // silently drop the property. itemKind is pinned because flipping
      // material <-> checklist would corrupt the completion percentages.
      allow update: if progressShapeOk()
        && request.resource.data.runId == resource.data.runId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.itemId == resource.data.itemId
        && request.resource.data.itemKind == resource.data.itemKind
        && request.resource.data.get('moderatedByUid', null)
          == resource.data.get('moderatedByUid', null)
        && request.resource.data.get('moderatedAt', null)
          == resource.data.get('moderatedAt', null);

      // A member may retract their own row (un-check everything, including a
      // moderated comment — deletion REMOVES content, which is the moderation
      // outcome, not a way around it). Admin delete backs the moderation route.
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // === courseExerciseResponses ===
    // Member exercise submissions. Routes-only writes: the response-type gate
    // (text vs link, per the week's exercise DEFINITION) cannot live in rules
    // — checking it would mean fetching the week doc and searching an array —
    // and the URL validation (validateSubmissionUrl) is string-parsing rules
    // can't do. Own-row read lets the member see their submission state;
    // facilitators review through the PII-free facilitator routes.
    match /courseExerciseResponses/{docId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // === courseAttendance ===
    // One register per (group, week), a map of uid -> status. That shape is
    // why even READS are locked: any row a member could read leaks every
    // other member's attendance. Facilitators mark and view attendance via
    // the group routes (Admin SDK), which scope what comes back.
    match /courseAttendance/{docId} {
      allow read, write: if false;
    }

    // === courseNudges ===
    // Server-side send-dedupe markers for the course reminder emails (the
    // no-cron lazy-send bookkeeping). Pure machinery, admin SDK both ways.
    match /courseNudges/{docId} {
      allow read, write: if false;
    }

    // === courseEmailTemplates ===
    // Admin-edited boilerplates for course lifecycle emails, mirroring
    // applicationEmailTemplates: fixed ids, block bodies, {token}
    // substitution at send time. Send routes use the Admin SDK; these rules
    // are for the admin editor client. Caps mirror COURSE_SUBJECT_MAX /
    // COURSE_TEMPLATE_MAX_BLOCKS in courseEmails.ts.
    match /courseEmailTemplates/{templateId} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 200
        && request.resource.data.get('blocks', []).size() <= 40;
    }

    // === courseTemplates ===
    // FROZEN CURRICULUM SNAPSHOTS (v2 decision 2) — `{ courseId, courseTitle,
    // label, sourceRunId, sourceGroupId, savedAt, savedByUid, savedByName,
    // weekCount, retrospective }` with the snapshotted week docs in a `weeks`
    // subcollection, ids preserved from the source run.
    //
    // EVERY CLIENT WRITE IS DENIED, admins included, on the doc AND on the
    // subcollection. This is the whole value of the collection, not a
    // tightening that could be relaxed later:
    //
    //  - a template is the record of what a cohort was ACTUALLY taught, and
    //    the thing next year's run is minted from. A snapshot you can edit
    //    afterwards is just a second, worse copy of the run;
    //  - the week docs carry the material / exercise / checklist IDS that
    //    member progress is keyed on (`courseProgress/{runId}__{uid}__
    //    {itemId}`). A client able to rewrite an id inside a template would
    //    be aiming the NEXT run's progress keys, silently, a year early;
    //  - the collection is APPEND-ONLY: saving mints a new id, so there is no
    //    legitimate client write to admit in the first place. The routes
    //    (Admin SDK) are POST /api/courses/[courseId]/templates and
    //    DELETE /api/courses/templates/[templateId], both admin-only, and
    //    NOTHING anywhere updates a template week.
    //
    // READ is the staff tier: admin, either course permission, or a track
    // lead — drafters and leads have to browse versions to pick one, and a
    // snapshot carries no PII (no member ids, no addresses, no per-member
    // anything; the `retrospective` map is three scalars).
    match /courseTemplates/{templateId} {
      // The track-lead branch, resolved against the SOURCE RUN — a template
      // carries no role fields of its own, so there is nothing on it for a
      // reader to tamper with first.
      //
      // ⚠ COST. This is a get() inside a READ rule, and `allow read` covers
      // `list`: a list query evaluates its rule PER CANDIDATE DOC, so this
      // bills one document access per row against the ~20-access budget (the
      // hazard courseProgress documents at length). Three things keep it
      // safe rather than lucky:
      //   * it is the LAST branch of a short-circuiting `||`, so it only ever
      //     runs for a caller who is not an admin, drafter or approver;
      //   * the admin UI reads versions through
      //     GET /api/courses/[courseId]/templates (Admin SDK), not by listing
      //     this collection — the client-read path exists for a single get();
      //   * a course holds a handful of snapshots, not hundreds.
      // A track lead listing more than ~20 snapshots straight from a client
      // will be denied wholesale. That is the documented ceiling. If a
      // surface ever needs that list, give it a route, don't widen this.
      //
      // A template whose `sourceRunId` names a run that no longer exists
      // (destroyed run, hand-deleted doc) DENIES this branch — get() on a
      // missing doc yields null and the lookup errors out, which is a deny.
      // Correct: nobody can be a track lead of a run that isn't there. The
      // privileged branches short-circuit before it, so a destroyed source
      // run never locks staff out of their own history.
      function isSourceRunTrackLead() {
        return isSignedIn()
          && resource.data.get('sourceRunId', '') is string
          && resource.data.get('sourceRunId', '').size() > 0
          && request.auth.uid in
            get(/databases/$(database)/documents/courseRuns/$(resource.data.sourceRunId))
              .data.get('trackLeadUids', []);
      }

      allow read: if isAdmin() || canDraftCourse() || canApproveCourse()
        || isSourceRunTrackLead();

      // Admin-only save/relabel/delete, all through routes. `write` covers
      // create, update AND delete in one clause on purpose: there is no
      // half-open door to reason about later.
      allow write: if false;

      // --- weeks (the frozen curriculum, ids preserved) ---
      match /weeks/{weekId} {
        // Same tier, one level down: the parent names the source run, so the
        // track-lead branch costs TWO gets. Same short-circuit, same ceiling,
        // same reasoning as above — and the same reason not to widen it.
        function parentTemplate() {
          return get(/databases/$(database)/documents/courseTemplates/$(templateId)).data;
        }
        allow read: if isAdmin() || canDraftCourse() || canApproveCourse()
          || (
            isSignedIn()
            && parentTemplate().get('sourceRunId', '') is string
            && parentTemplate().get('sourceRunId', '').size() > 0
            && request.auth.uid in
              get(/databases/$(database)/documents/courseRuns/$(parentTemplate().sourceRunId))
                .data.get('trackLeadUids', [])
          );

        // IMMUTABLE. Not "server-owned like the role arrays" — immutable:
        // the snapshot batch is the only write these docs ever receive, and
        // it happens on the Admin SDK before anyone can see them. Pinned in
        // scripts/rules-tests/tests/course-templates.test.mjs, including for
        // admins.
        allow write: if false;
      }
    }

    // === courseMaterialNotes ===
    // `{runId}__{itemId}__{uid}` — one facilitator's "how did this land" note
    // on one piece of material, the named half of the retrospective loop
    // (v2 decision 3).
    //
    // WRITES ARE ROUTE-ONLY (POST /api/courses/runs/[runId]/material-notes)
    // for three reasons rules cannot express:
    //   * authority is a QUERY — "a facilitator of any group in this run"
    //     means reading `courseGroups`, which a rule cannot do;
    //   * `weekNumber` is SERVER-DERIVED from the week doc whose materials
    //     actually contain `itemId`, so a note cannot be filed against a week
    //     the material is not in (where the retrospective, which builds its
    //     rows from the current week definitions, would never render it);
    //   * `byName` is resolved from the author's user doc, so a note can
    //     never carry a name its author picked.
    //
    // READS are the retrospective's own tier — admin, either course
    // permission, or the run's track leads. Deliberately NOT the note's own
    // author on the client: facilitators write notes through the route and
    // read them back through the retrospective (also a route), so admitting a
    // client read here would widen the surface for nothing. When V2-3 gives
    // facilitators their own view, it gets a route too.
    //
    // Members are excluded outright, including from their own materials'
    // notes. These are staff assessments of the curriculum ("this reading
    // confused everyone"), written on the understanding that the cohort is
    // not the audience.
    match /courseMaterialNotes/{noteId} {
      function isNotedRunTrackLead() {
        return isSignedIn()
          && resource.data.get('runId', '') is string
          && resource.data.get('runId', '').size() > 0
          && request.auth.uid in
            get(/databases/$(database)/documents/courseRuns/$(resource.data.runId))
              .data.get('trackLeadUids', []);
      }
      // Same get()-in-a-read-rule caveat as courseTemplates: last branch of a
      // short-circuiting ||, and the retrospective route (Admin SDK) is what
      // actually renders these. Don't list this collection from a client.
      allow read: if isAdmin() || canDraftCourse() || canApproveCourse()
        || isNotedRunTrackLead();
      allow write: if false;
    }

    // ==================== V3 W1 PR5: courses open mode ====================
    //
    // === courseAudit ===
    // ONE append-only log for every course operational action that has to
    // stay answerable after the fact: a register pushed or edited after the
    // lock, a facilitator appointed or removed, a member dropping out, a run
    // settled, a run's enrolment mode changed, a week unlocked early, and an
    // applicant's access-requirements answer being read.
    //
    // The posture is `courseDeletions`', verbatim and for its reason: reads
    // are admin-only and writes are shut to EVERY client, admins included.
    // An append-only log its own actor can amend is not an audit trail. Every
    // writer is an Admin SDK route.
    //
    // Rows are staff-action METADATA, never member content: `detail` is a
    // route-written sentence, and nothing here holds an applicant's answers,
    // their access requirements or a facilitator's notes about them, only the
    // fact that a named actor touched them. See src/lib/firestore/courseAudit
    // .ts for the retention decision (audits survive account deletion, as
    // impersonations and courseDeletions already do) and the kind union.
    //
    // ⚠ A `firebase deploy --only firestore:rules` IS OWED when this merges,
    // the same standing RULES-FIRST order as courseDeletions below: until it
    // lands the collection is deny-by-default, so the Admin SDK writers keep
    // working and the admin log renders empty.
    match /courseAudit/{auditId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // === config ===
    // Server-only runtime config, written by the Admin SDK and read only by
    // routes: `config/taskEmails` (the task-email kill switch),
    // `config/courses` (grace windows, the drop-out feedback URL, the
    // scheduler scan budgets). NOTE, like pushSubscriptions: with no `allow`
    // this match is identical to Firestore's implicit deny, so no rules
    // deploy is owed for it. It exists so the lockdown of a collection that
    // is about to gain several documents is VISIBLE here rather than inferred
    // from the absence of a block. The failure mode is a later wildcard
    // opening a collection nobody remembered was closed.
    match /config/{doc} {
      allow read, write: if false;
    }

    // === courseDeletions ===
    // The DESTROY audit log of the V2-1 deletion protocol: one doc per destroy
    // attempt, `{ kind: "run" | "course", targetId, targetLabel, startedAt,
    // startedByUid, startedByName, manifestCounts, deleted, completedAt,
    // resumeCount }`. Written ONLY by the destroy routes
    // (/api/courses/runs/[runId]/destroy, /api/courses/[courseId]/destroy) on
    // the Admin SDK, which open the row BEFORE the first delete and accumulate
    // into it on every resume — the impersonations `audit-first` pattern, for
    // the same reason: a cascade that dies mid-page must still leave a record
    // naming what it was told to destroy and how far it got.
    //
    // Reads are admin-only and writes are shut to EVERY client, admins
    // included. This log is the only surviving evidence of a destroy — the
    // rows it describes are gone — so a client able to touch it could rewrite
    // or erase the record of its own cascade, and an append-only log that its
    // own actor can amend is not an audit trail. Counts are also read back by
    // the resumable-cascade UI, which is exactly the kind of consumer that
    // makes a writable log tempting; it reads through the route instead.
    //
    // ⚠ A `firebase deploy --only firestore:rules` IS OWED when this merges.
    // Until it lands, this collection hits deny-by-default: the destroy routes
    // are Admin SDK and keep working, but the admin Danger-zone client cannot
    // read a single audit row, so a completed destroy renders as if it never
    // ran. Deploy rules to the target project BEFORE (or with) the rollout,
    // dev and prod each — the standing "RULES FIRST" order for this platform.
    match /courseDeletions/{auditId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // =====================================================================
    // === V3 W1 PR4: admissions ===========================================
    // =====================================================================
    //
    // Six collections, every one of them `allow read, write: if false`.
    // That is unusually blunt for this file, so each half is argued below.
    // "Deny everything" is only a good rule when someone has checked that
    // nothing legitimate needed the door.
    //
    // WHY NO CLIENT WRITES ANYWHERE. Every one of these carries something
    // rules cannot express: counters that must move in the same transaction
    // as a status (`applicationCounts`), a cross-document membership check
    // (`round.reviewerUids`), a self-review guard, a server-recomputed
    // total, or free text about a named person. The routes are Admin SDK and
    // are the security boundary. That also makes the round's status
    // transition table safe to keep in one route rather than duplicated
    // here; if the write rule is ever relaxed, the table has to come with
    // it, or the machine is three client writes from being walked
    // backwards, exactly as `canApproveCourse()` can walk a live run back to
    // draft today.
    //
    // WHY NO CLIENT READS EITHER, including own-row ones. This is the half
    // that looks over-tight, so it is itemised:
    //
    //  - `admissionRounds` carries live `applicationCounts`, so a signed-in
    //    read lets any fresher watch a competitive intake's submitted /
    //    accepted / rejected counters move through the week their own
    //    application is being decided; and `finalDeciderUid`, so they learn
    //    who decides it. Nothing needs the client read: every staff surface
    //    goes through GET /api/admissions/rounds[/[roundId]] for blinding
    //    anyway, and the public round page is a server component.
    //  - `.../stages` is THE release guarantee. `courseRuns` is
    //    `allow read: if isSignedIn()` (see the block above), so questions
    //    authored on a run document are readable the moment they are saved
    //    and a timed release there is cosmetic. Here the only way a
    //    question reaches a browser is a route that called
    //    `isStageReleased` first. Subcollections do NOT inherit, so this
    //    match block is required rather than decorative.
    //  - `admissionApplications` would be the obvious own-row read, and it
    //    is the sharpest one to refuse: the row carries
    //    `evidence.facilitatorNotes` (a facilitator's private assessment of
    //    the applicant) and `outcome.reason` alongside `outcome.reasonShared`
    //    (the tick that decides whether they ever see it). An own-row read
    //    hands the applicant reviewer-only material and an unshared
    //    rejection reason from the browser console. The status hub is an
    //    Admin SDK server component, so the rule bought nothing. If an
    //    own-row read is ever wanted, those fields move to a routes-only
    //    sibling FIRST.
    //  - `admissionApplicationPrivate` holds the access-requirements answer
    //    and nothing else. In practice that is disability and health
    //    information. One reader, one route, and every read appends a
    //    `courseAudit` row.
    //  - `admissionReviews` read:false rather than own-row so no client can
    //    enumerate who scored whom, which is the correlation a name-blind
    //    process exists to prevent.
    //  - `memberConductFlags` is off `users/{uid}` precisely because that
    //    doc is own-row readable AND `AuthProvider` holds a live
    //    `onSnapshot` on it, so a free-text misconduct reason there would
    //    stream into the flagged member's own browser on every authed page
    //    and could expose the reporter. Reviewers get a boolean chip through
    //    a route payload; only admins ever see `reason`.
    //
    // Read:false also means there is no read rule for a `get()` to enter, so
    // the "never a get() in a read rule" constraint is satisfied
    // structurally here rather than by care.
    //
    // ⚠ A `firebase deploy --only firestore:rules` is NOT owed for these six
    // blocks: with no `allow`, each match is identical to Firestore's
    // implicit deny (the `pushSubscriptions` precedent below). They are
    // written out so the lockdown is visible here rather than inferred, and
    // so a later wildcard cannot silently open one of them. The composite
    // indexes in `firestore.indexes.json` ARE owed a deploy, and they take
    // minutes to build.

    match /admissionRounds/{roundId} {
      allow read, write: if false;
    }

    match /admissionRounds/{roundId}/stages/{stageId} {
      allow read, write: if false;
    }

    match /admissionApplications/{applicationId} {
      allow read, write: if false;
    }

    match /admissionApplicationPrivate/{applicationId} {
      allow read, write: if false;
    }

    match /admissionReviews/{reviewId} {
      allow read, write: if false;
    }

    match /memberConductFlags/{uid} {
      allow read, write: if false;
    }

    // === end V3 W1 PR4: admissions =======================================

    // Web push subscriptions: one row per device endpoint, written ONLY by
    // the Admin SDK routes under /api/push/*. Clients never touch it — the
    // endpoint plus its keys IS the capability to push to that device's
    // lock screen, so a readable row would let any member push at any other.
    // NOTE unlike the block above, no rules deploy is owed for this: with no
    // allow, the match is identical to Firestore's implicit deny. It exists
    // so the collection's lockdown is visible here rather than inferred.
    match /pushSubscriptions/{subId} {
      allow read, write: if false;
    }
  }
}
