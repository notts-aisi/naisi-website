rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    // Newsletter images: public read (emails render without auth),
    // writes gated to admins + newsletter drafters + newsletter approvers
    // via a cross-service Firestore lookup on users/{uid}. Belt-and-braces:
    // 5MB size cap + image MIME check.
    // Scoped per draft for the same reason as event-images below: without an
    // ownership test any `draftNewsletter` holder could overwrite the imagery
    // of a draft they do not own, including one already approved and awaiting
    // send. Approvers keep blanket write so they can fix a draft under review.
    match /newsletter-images/{draftId}/{image=**} {
      function parentDraft() {
        return firestore.get(/databases/(default)/documents/newsletterDrafts/$(draftId)).data;
      }
      allow read: if true;
      allow write: if request.auth != null
        && (
          userData().role == 'admin'
          || userData().get(['permissions', 'approveNewsletter'], false) == true
          || (
            userData().get(['permissions', 'draftNewsletter'], false) == true
            // Ownership is enforced only once the draft EXISTS. firestore.get()
            // on a missing document returns null and `.get()` on null raises,
            // which would deny-by-error; and the editor can legitimately reach
            // here before the doc has settled. Uploading under an id that does
            // not exist is harmless (nothing references it) — the hole this
            // closes was overwriting the images of a draft owned by SOMEONE ELSE.
            && (
              !firestore.exists(/databases/(default)/documents/newsletterDrafts/$(draftId))
              || parentDraft().get('authorUid', '') == request.auth.uid
            )
          )
        )
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Event images: same shape as newsletter — public read so rendered emails
    // and the public /events page work without auth; writes gated to admins +
    // event drafters + event approvers, AND scoped to the specific event.
    //
    // The per-document scoping PR #225 added to firestore.rules stopped at the
    // Firestore boundary: a member holding only the (deliberately low-privilege)
    // `draftEvent` permission was denied another author's event DOCUMENT while
    // still being allowed to overwrite that event's cover IMAGE here, because
    // this block tested only the global permission. Since the path is
    // world-readable, that is public defacement of the live site and of
    // already-sent emails that hot-link the image. Mirror the document rule:
    // author, named collaborator, approver, or admin.
    match /event-images/{eventId}/{image=**} {
      function parentEvent() {
        return firestore.get(/databases/(default)/documents/events/$(eventId)).data;
      }
      allow read: if true;
      allow write: if request.auth != null
        && (
          userData().role == 'admin'
          || userData().get(['permissions', 'approveEvent'], false) == true
          || (
            userData().get(['permissions', 'draftEvent'], false) == true
            // Same null-safety as newsletter-images above.
            && (
              !firestore.exists(/databases/(default)/documents/events/$(eventId))
              || parentEvent().get('authorUid', '') == request.auth.uid
            )
          )
          || (
            firestore.exists(/databases/(default)/documents/events/$(eventId))
            && request.auth.uid in parentEvent().get('collaboratorUids', [])
          )
        )
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Application-email images: public read (a sent email renders in an inbox
    // with no auth, same as newsletter/event images), admin-only write — the
    // Email designs tab is admin-only.
    //
    // This block was MISSING, so every image upload in that editor hit
    // deny-by-default and failed with storage/unauthorized in production.
    // Same failure as ce8f140 ("unbreak ... event-image uploads in prod"), for
    // the same reason: Storage rules deploy separately via
    // `firebase deploy --only storage` and nothing verifies the deployed set
    // matches this file. The recursive {image=**} also tolerates the
    // double-nested path the editor currently builds
    // (application-emails/<id>/<id>/<file>).
    match /application-emails/{templateId}/{image=**} {
      allow read: if true;
      allow write: if request.auth != null
        && userData().role == 'admin'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Course images: the guide imagery in a week's editor and the intro on a
    // course's public page. Public read for the same reason as every block
    // above (the published course page and the curriculum preview are served
    // to signed-out visitors), and writes gated to admins plus the two course
    // permissions, matching `canDraftCourse` / `canApproveCourse` and the
    // `courses` rules in firestore.rules.
    //
    // This block was MISSING, exactly as `event-images` and `application-emails`
    // were before it, and with the same result: every image upload in the
    // course and week editors hit deny-by-default and failed with
    // storage/unauthorized. Both editors' own comments predicted it. Storage
    // rules deploy separately (`firebase deploy --only storage`) and nothing
    // verifies the deployed set matches this file, so the pattern keeps
    // repeating; `scripts/rules-tests/tests/storage.test.mjs` is what stops it.
    //
    // NO per-document ownership scoping, unlike newsletter-images and
    // event-images, and deliberately so: `{folder}` is not one document id. The
    // course editor uploads under a courseId and the week editor under a
    // `runId__weekId` pair, so there is no single document to read an authorUid
    // from, and a rule that guessed would deny one of the two editors. Course
    // authoring is an admin-granted permission held by a handful of people who
    // are already trusted to edit each other's runs (courses have no per-course
    // author gate in firestore.rules either), so the permission IS the scope
    // here. If courses ever grow a per-course author, mirror event-images.
    match /course-images/{folder}/{image=**} {
      allow read: if true;
      allow write: if request.auth != null
        && (
          userData().role == 'admin'
          || userData().get(['permissions', 'approveCourse'], false) == true
          || userData().get(['permissions', 'draftCourse'], false) == true
        )
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Task attachments: mirror the Firestore task access gate — anyone who
    // can read the parent task can read/upload, and delete is author-or-admin.
    // 10MB cap; MIME allowlist covers images, PDFs, common office docs, zips.
    // Path is tasks/{taskId}/{attachmentId}/{filename} so each attachment
    // gets its own folder keyed by the metadata doc id — clean delete.
    match /tasks/{taskId}/{attachmentId}/{filename} {
      function parentTask() {
        return firestore.get(/databases/(default)/documents/tasks/$(taskId)).data;
      }
      // MUST mirror firestore.rules' canAccessParent() on the attachments
      // subcollection. It did not: this file checked only
      // `role in ['committee','admin']`, and the word `suRecognised` appeared
      // nowhere in it — so Firestore denied a non-SU committee member the task
      // document AND its attachment metadata, while Storage happily served the
      // attachment blobs themselves. `suRecognised` is the trust boundary that
      // decides who sees committee material at all (see CLAUDE.md: non-SU
      // committee collaborate only on tasks they are explicitly added to), so
      // the file gate has to honour it too. Being named on the task still
      // grants access via the completer/reviewer branches below, which is
      // exactly how a non-SU committee member is meant to reach one.
      function canAccessTask() {
        return request.auth != null && (
          userData().role == 'admin'
          || (userData().role == 'committee'
              && userData().get('suRecognised', false) == true
              && parentTask().visibility == 'committee')
          || request.auth.uid in parentTask().completerUids
          || request.auth.uid in parentTask().reviewerUids
        );
      }
      function isAttachmentUploader() {
        return firestore.get(
          /databases/(default)/documents/tasks/$(taskId)/attachments/$(attachmentId)
        ).data.uploadedByUid == request.auth.uid;
      }
      allow read: if canAccessTask();
      allow write: if canAccessTask()
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('text/.*')
          || request.resource.contentType.matches('application/vnd\\.openxmlformats.*')
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/zip'
        );
      allow delete: if canAccessTask()
        && (userData().role == 'admin' || isAttachmentUploader());
    }

    // Worksheet imagery: the pictures inside a question's body or on one of
    // its options. Written by whoever is authoring the questions, which is any
    // committee member in the library and the circulation's staff mid-flight.
    //
    // PER-DOCUMENT OWNERSHIP SCOPING, mirroring firestore.rules, because
    // `{ownerId}` is TWO kinds of id and both can be probed. It is a WORKSHEET
    // id in the library editor and a CIRCULATION id when staff edit the sent
    // copy, and an earlier draft of this block took that as licence to gate on
    // committee membership alone (the course-images reasoning). It is not the
    // same case: course authoring has no per-document author to mirror, while
    // a worksheet has `authorUid` and a circulation has `staffUids`, and
    // firestore.rules enforces both. Left at bare committee membership, a
    // committee member refused `update` on somebody else's worksheet could
    // still overwrite that worksheet's body and option images, and overwrite
    // the imagery inside a live circulation that recipients are reading. That
    // is the event-images hole forty lines above, repeated on a path added
    // afterwards, so it is closed here the same way and at the same price:
    // one exists() plus one get() against whichever collection the id names.
    //
    // The neither-exists branch is the newsletter-images null-safety branch
    // and exists for the same reason: firestore.get() on a missing document
    // returns null and .get() on null RAISES, denying by error, and an editor
    // can legitimately upload the first image before its document has settled.
    // Uploading under an id that names nothing is harmless because nothing
    // references it; the hole being closed is overwriting SOMEBODY ELSE'S.
    //
    // Admins keep blanket write, matching "edit somebody else's worksheet:
    // admins only" in docs/worksheets.md, so an admin fixing a broken image
    // never has to go through the author.
    //
    // Read is SIGNED-IN rather than public, unlike every image block above.
    // Those are public because a sent email and the public site render them
    // with no session; a worksheet is never public, and a question body can
    // carry a screenshot of something internal.
    //
    // `image/svg+xml` is refused EXPLICITLY. It satisfies `image/.*`, it is a
    // document format that can carry script, and this path is readable by
    // every signed-in account including a brand-new pending one, so the
    // characterisation recorded against newsletter-images (an SVG on a
    // world-readable path) is not a thing to repeat on a path being added
    // today.
    match /worksheet-images/{ownerId}/{image=**} {
      function worksheetPath() {
        return /databases/(default)/documents/worksheets/$(ownerId);
      }
      function circulationPath() {
        return /databases/(default)/documents/circulations/$(ownerId);
      }
      // Author of the worksheet this folder belongs to, or staff of the
      // circulation it belongs to, or neither document exists yet.
      function ownsFolder() {
        return (
          firestore.exists(worksheetPath())
            && firestore.get(worksheetPath()).data.get('authorUid', '') == request.auth.uid
        ) || (
          firestore.exists(circulationPath())
            && request.auth.uid in firestore.get(circulationPath()).data.get('staffUids', [])
        ) || (
          !firestore.exists(worksheetPath()) && !firestore.exists(circulationPath())
        );
      }
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (
          userData().role == 'admin'
          || (userData().role == 'committee' && ownsFolder())
        )
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && request.resource.contentType != 'image/svg+xml';
    }

    // Worksheet image ANSWERS: what a recipient uploaded in reply to an
    // imageUpload question. Read by that recipient, the circulation's staff
    // and admins.
    //
    // NO CLIENT WRITE AT ALL, admin and recipient included. The file goes
    // through POST /api/worksheets/circulations/{id}/upload, which checks the
    // MAGIC BYTES (PNG, JPEG, GIF, WebP; SVG refused) rather than trusting the
    // Content-Type the client declares, enforces the size cap after the
    // client's compression pass, writes with the Admin SDK and returns the
    // { url, storagePath } pair the answer stores. A storage rule can only see
    // the declared content type, which is a claim, so there is no version of
    // this block that would be equivalent to the route.
    //
    // The recipient branch is tested FIRST and reads nothing: {uid} is a path
    // segment, so a recipient reaching their own upload costs no cross-service
    // lookup and cannot be aimed at anybody else's folder. The staff branch is
    // guarded with exists() because firestore.get() on a missing document
    // returns null and .get() on null raises, which would deny by error rather
    // than by decision.
    match /worksheet-uploads/{circulationId}/{uid}/{file} {
      function parentCirculation() {
        return firestore.get(/databases/(default)/documents/circulations/$(circulationId)).data;
      }
      allow read: if request.auth != null
        && (
          request.auth.uid == uid
          || userData().role == 'admin'
          || (
            firestore.exists(/databases/(default)/documents/circulations/$(circulationId))
            && request.auth.uid in parentCirculation().get('staffUids', [])
          )
        );
      allow write: if false;
    }
  }
}
