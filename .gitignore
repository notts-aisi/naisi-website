# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# Nested packages (scripts/rules-tests) — the rule above is root-anchored, so
# without this their node_modules would be committed.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# Template for the e2e harness config. The real .env.e2e.local it is copied to
# holds dev credentials and stays ignored by the .env* rule above.
!.env.e2e.local.example

# firebase
.firebase/
firebase-debug.log
firebase-debug.*.log
# Emulator output from scripts/rules-tests
firestore-debug.log
ui-debug.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local-only hero animation variant archive. The /hero-alts route +
# every HeroField*.tsx iteration variant lives here. Production hero
# only needs HeroFieldZeroBase + HeroFieldStaggerCore (the shared core)
# + the original legacy variants that were tracked before the rework;
# everything else is local-only for revisiting alternate directions.
src/app/(public)/hero-alts/
src/app/(public)/HeroField*.tsx
!src/app/(public)/HeroField.tsx
!src/app/(public)/HeroFieldStaggerCore.tsx
!src/app/(public)/HeroFieldZeroBase.tsx
!src/app/(public)/HeroFieldImpulses.tsx
!src/app/(public)/HeroFieldParticles.tsx
!src/app/(public)/HeroFieldTfStyle.tsx
